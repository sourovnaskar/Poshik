  <!-- ======== FEATURES SECTION ======== -->
  <section id="features" class="py-20 lg:py-28 px-4 sm:px-6 max-w-7xl mx-auto">
    <div class="text-center mb-16 reveal">
      <span class="inline-block text-brand-600 font-bold text-sm uppercase tracking-widest bg-brand-50 px-4 py-1.5 rounded-full mb-4">Everything you need</span>
      <h2 class="font-display text-4xl sm:text-5xl font-black text-slate-900 mb-5 leading-tight">
        A Complete Pet Care <br><span class="gradient-text">Ecosystem</span>
      </h2>
      <p class="text-slate-500 text-lg max-w-2xl mx-auto leading-relaxed">
        From booking a vet appointment to ordering premium food — Poshik brings every pet care need under one roof.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-7">

      <%
      const features = [
        { icon: 'fa-calendar-alt', emoji: '🩺', color: 'from-emerald-400 to-teal-500', bg: 'bg-emerald-50', border: 'border-emerald-100', title: 'Book Vet Appointments', desc: 'Find certified veterinarians nearby, view their schedules in real time, and book appointments with instant confirmation — no calls needed.' },
        { icon: 'fa-shopping-bag', emoji: '🛍️', color: 'from-amber-400 to-orange-500', bg: 'bg-amber-50', border: 'border-amber-100', title: 'Premium Pet Shop', desc: 'Browse hundreds of curated products — premium food, toys, accessories, medicines — all from verified pet shops across India.' },
        { icon: 'fa-paw', emoji: '🐾', color: 'from-violet-400 to-purple-500', bg: 'bg-violet-50', border: 'border-violet-100', title: 'Pet Profile Manager', desc: 'Create and manage detailed profiles for each of your pets — track breed, age, vaccinations, medical history and more.' },
