            <!-- Floating card 2: Order on the way -->
            <div class="badge-float2 absolute -bottom-4 -right-4 sm:-right-10 glass-white rounded-2xl px-4 py-3 shadow-xl2 flex items-center gap-3 min-w-max">
              <div class="w-10 h-10 rounded-xl bg-warm-100 flex items-center justify-center text-warm-600 text-lg">
                <i class="fas fa-truck"></i>
              </div>
