<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <meta name="description" content="Poshik is India's all-in-one pet care platform. Book veterinarians, shop premium pet products, and manage your pet's health — all in one place." />
  <meta name="keywords" content="pet care, veterinarian booking, pet shop, pet health, Poshik, India" />
  <meta property="og:title" content="Poshik — Care for Your Pet, Made Simple" />
  <meta property="og:description" content="Book vets, shop pet products, manage your pet's health — Poshik has it all." />
  <meta property="og:type" content="website" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&family=Fraunces:opsz,wght@9..144,700;9..144,900&display=swap" rel="stylesheet">

  <!-- Tailwind + Icons -->
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            display: ['Fraunces', 'serif'],
          },
          colors: {
            brand: { 50:'#ecfdf5', 100:'#d1fae5', 200:'#a7f3d0', 300:'#6ee7b7', 400:'#34d399', 500:'#10b981', 600:'#059669', 700:'#047857', 800:'#065f46', 900:'#064e3b' },
            warm: { 50:'#fffbeb', 100:'#fef3c7', 200:'#fde68a', 300:'#fcd34d', 400:'#fbbf24', 500:'#f59e0b', 600:'#d97706' },
            rose: { 50:'#fff1f2', 100:'#ffe4e6', 500:'#f43f5e', 600:'#e11d48' },
          },
          animation: {
            'float': 'float 6s ease-in-out infinite',
            'float-delay': 'float 6s ease-in-out 2s infinite',
            'slide-up': 'slideUp 0.8s ease-out forwards',
            'fade-in': 'fadeIn 1s ease-out forwards',
            'pulse-slow': 'pulse 3s ease-in-out infinite',
            'bounce-slow': 'bounce 2.5s infinite',
          },
          keyframes: {
            float: { '0%,100%': { transform: 'translateY(0)' }, '50%': { transform: 'translateY(-18px)' } },
            slideUp: { '0%': { opacity: '0', transform: 'translateY(40px)' }, '100%': { opacity: '1', transform: 'translateY(0)' } },
            fadeIn: { '0%': { opacity: '0' }, '100%': { opacity: '1' } },
          },
          backgroundImage: {
            'hero-gradient': 'linear-gradient(135deg, #064e3b 0%, #065f46 30%, #047857 60%, #059669 100%)',
            'card-gradient': 'linear-gradient(145deg, rgba(255,255,255,0.9), rgba(255,255,255,0.6))',
          },
          boxShadow: {
            'glow': '0 0 40px rgba(16, 185, 129, 0.3)',
            'glow-warm': '0 0 40px rgba(251, 191, 36, 0.3)',
            'xl2': '0 25px 60px rgba(0,0,0,0.12)',
          }
        }
      }
    }
  </script>

  <style>
    html { scroll-behavior: smooth; }
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
    .font-display { font-family: 'Fraunces', serif; }

    /* Glassmorphism */
    .glass {
      background: rgba(255, 255, 255, 0.12);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1px solid rgba(255, 255, 255, 0.2);
    }
    .glass-white {
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
    }

    /* Animated gradient text */
    .gradient-text {
      background: linear-gradient(135deg, #10b981, #34d399, #fbbf24);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      background-size: 200%;
      animation: shimmer 3s ease-in-out infinite;
    }
    @keyframes shimmer {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    /* Mesh gradient background */
    .mesh-bg {
      background: radial-gradient(ellipse at 20% 50%, rgba(16,185,129,0.15) 0%, transparent 50%),
                  radial-gradient(ellipse at 80% 20%, rgba(251,191,36,0.10) 0%, transparent 40%),
                  radial-gradient(ellipse at 50% 80%, rgba(6,95,70,0.12) 0%, transparent 50%),
                  #f8fffe;
    }

    /* Blob shapes */
    .blob {
      border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
      animation: blob-morph 8s ease-in-out infinite;
    }
    @keyframes blob-morph {
      0%,100% { border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%; }
      25% { border-radius: 30% 60% 70% 40% / 50% 60% 30% 60%; }
      50% { border-radius: 40% 60% 60% 40% / 30% 70% 30% 70%; }
      75% { border-radius: 70% 30% 40% 60% / 60% 30% 70% 40%; }
    }

    /* Feature card hover */
    .feature-card {
      transition: transform 0.35s cubic-bezier(.34,1.56,.64,1), box-shadow 0.35s ease;
    }
    .feature-card:hover {
      transform: translateY(-10px) scale(1.02);
      box-shadow: 0 30px 60px rgba(0,0,0,0.12);
    }

    /* Stat counter pop */
    .stat-card {
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .stat-card:hover {
      transform: scale(1.05);
      box-shadow: 0 20px 50px rgba(16,185,129,0.2);
    }

    /* Scroll reveal via intersection observer */
    .reveal { opacity: 0; transform: translateY(30px); transition: opacity 0.7s ease, transform 0.7s ease; }
    .reveal.visible { opacity: 1; transform: none; }
    .reveal-left { opacity: 0; transform: translateX(-30px); transition: opacity 0.7s ease, transform 0.7s ease; }
    .reveal-left.visible { opacity: 1; transform: none; }
    .reveal-right { opacity: 0; transform: translateX(30px); transition: opacity 0.7s ease, transform 0.7s ease; }
    .reveal-right.visible { opacity: 1; transform: none; }

    /* Navbar scroll effect */
    .navbar-scrolled {
      background: rgba(255, 255, 255, 0.95) !important;
      backdrop-filter: blur(20px);
      box-shadow: 0 4px 24px rgba(0,0,0,0.08);
    }

    /* Custom scrollbar */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: #f1f5f9; }
    ::-webkit-scrollbar-thumb { background: #10b981; border-radius: 10px; }

    /* Mobile menu transition */
    #mobile-menu { transition: max-height 0.4s ease, opacity 0.3s ease; overflow: hidden; max-height: 0; opacity: 0; }
    #mobile-menu.open { max-height: 500px; opacity: 1; }

    /* Hero image float */
    .hero-img-wrap { animation: float 6s ease-in-out infinite; }
    .badge-float { animation: float 6s ease-in-out 1s infinite; }
    .badge-float2 { animation: float 6s ease-in-out 3s infinite; }

    /* Process step connector */
    .step-connector { position: relative; }
    .step-connector::after {
      content: '';
      position: absolute;
      top: 28px;
      right: -50%;
      width: 100%;
      height: 2px;
      background: linear-gradient(90deg, #10b981, #d1fae5);
      display: none;
    }
    @media (min-width: 768px) {
      .step-connector::after { display: block; }
    }
    .step-connector:last-child::after { display: none !important; }

    /* CTA gradient button */
    .btn-primary-cta {
      background: linear-gradient(135deg, #059669, #10b981);
      box-shadow: 0 8px 30px rgba(16,185,129,0.4);
      transition: all 0.3s ease;
    }
    .btn-primary-cta:hover {
      background: linear-gradient(135deg, #047857, #059669);
      box-shadow: 0 12px 40px rgba(16,185,129,0.6);
      transform: translateY(-2px);
    }
    .btn-secondary-cta {
      border: 2px solid rgba(255,255,255,0.4);
      background: rgba(255,255,255,0.1);
      transition: all 0.3s ease;
    }
    .btn-secondary-cta:hover {
      background: rgba(255,255,255,0.25);
      border-color: rgba(255,255,255,0.7);
      transform: translateY(-2px);
    }
  </style>
</head>

<body class="mesh-bg text-slate-800 antialiased overflow-x-hidden">

