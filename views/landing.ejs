          { value: '150+', label: 'Verified Vets', icon: 'fa-user-md', color: 'bg-warm-400/10 text-warm-300' },
          { value: '500+', label: 'Pet Products', icon: 'fa-box-open', color: 'bg-rose-500/10 text-rose-300' },
