            <span class="w-2 h-2 rounded-full bg-brand-300 animate-pulse"></span>
            <span class="text-brand-200 text-xs font-semibold tracking-wide uppercase">India's #1 Pet Care Platform</span>
          </div>

          <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl font-black text-white leading-[1.05] mb-6">
            Care for Your <br>
            <span class="text-warm-300 relative inline-block">
              Pet
              <svg class="absolute -bottom-2 left-0 w-full" viewBox="0 0 200 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M2 9C50 3 150 3 198 9" stroke="#fbbf24" stroke-width="3" stroke-linecap="round"/>
              </svg>
            </span>, <br>Made Simple
          </h1>

          <p class="text-brand-100 text-lg sm:text-xl leading-relaxed mb-10 max-w-xl mx-auto lg:mx-0">
            Book certified veterinarians, shop premium pet products, track health records, and manage your furry family — all from one powerful platform.
          </p>

          <!-- CTA Buttons -->
          <div class="flex flex-col sm:flex-row items-center gap-4 justify-center lg:justify-start">
            <a href="/api/auth/register" id="hero-cta" class="w-full sm:w-auto px-8 py-4 font-bold text-slate-900 bg-warm-300 hover:bg-warm-400 rounded-2xl text-base shadow-glow-warm transition-all duration-300 hover:-translate-y-1 flex items-center justify-center gap-2">
              <i class="fas fa-paw"></i>
              Start for Free
              <i class="fas fa-arrow-right text-sm"></i>
            </a>
            <a href="#how-it-works" class="w-full sm:w-auto px-8 py-4 font-bold text-white btn-secondary-cta rounded-2xl text-base flex items-center justify-center gap-2">
              <i class="fas fa-play-circle"></i>
              See How It Works
            </a>
          </div>

          <!-- Social proof / trust bar -->
          <div class="mt-12 flex flex-col sm:flex-row items-center gap-6 justify-center lg:justify-start">
            <div class="flex -space-x-3">
              <img src="https://i.pravatar.cc/40?img=11" alt="user" class="w-10 h-10 rounded-full border-2 border-brand-700 object-cover">
              <img src="https://i.pravatar.cc/40?img=22" alt="user" class="w-10 h-10 rounded-full border-2 border-brand-700 object-cover">
              <img src="https://i.pravatar.cc/40?img=33" alt="user" class="w-10 h-10 rounded-full border-2 border-brand-700 object-cover">
              <img src="https://i.pravatar.cc/40?img=44" alt="user" class="w-10 h-10 rounded-full border-2 border-brand-700 object-cover">
              <div class="w-10 h-10 rounded-full border-2 border-brand-700 bg-brand-500 flex items-center justify-center text-white text-xs font-bold">2K+</div>
            </div>
            <div>
              <div class="flex items-center gap-1 text-warm-300 mb-0.5">
                <i class="fas fa-star text-sm"></i><i class="fas fa-star text-sm"></i><i class="fas fa-star text-sm"></i><i class="fas fa-star text-sm"></i><i class="fas fa-star text-sm"></i>
              </div>
              <p class="text-brand-200 text-sm font-medium">Trusted by 2,000+ happy pet owners</p>
            </div>
