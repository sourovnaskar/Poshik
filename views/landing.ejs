        { icon: 'fa-chart-line', emoji: '📊', color: 'from-rose-400 to-pink-500', bg: 'bg-rose-50', border: 'border-rose-100', title: 'Doctor & Shop Dashboards', desc: 'Vets and shop owners get powerful dashboards to manage schedules, appointments, inventory, and grow their business on Poshik.' },
        { icon: 'fa-shield-alt', emoji: '🛡️', color: 'from-slate-500 to-slate-700', bg: 'bg-slate-50', border: 'border-slate-100', title: 'Safe & Secure Platform', desc: 'JWT authentication, role-based access control, and encrypted data ensure your account and your pet\'s data remain protected always.' },
