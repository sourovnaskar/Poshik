<%- include('partials/header') %>

<!-- Dashboard Content -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 mb-8">
  <!-- Stat Card: Users -->
  <div class="glass-card rounded-2xl p-6 relative overflow-hidden group hover:-translate-y-1 transition-all duration-300">
    <div class="absolute top-0 right-0 -mr-8 -mt-8 w-32 h-32 rounded-full bg-blue-500/10 blur-2xl group-hover:bg-blue-500/20 transition-all"></div>
    <div class="flex items-center justify-between mb-4 relative z-10">
      <div class="w-12 h-12 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center text-xl shadow-inner">
        <i class="fas fa-users"></i>
      </div>
      <span class="text-sm font-medium text-emerald-500 bg-emerald-50 px-2.5 py-1 rounded-full"><i class="fas fa-arrow-up text-xs mr-1"></i> Active</span>
    </div>
    <div class="relative z-10">
      <h3 class="text-slate-500 text-sm font-medium mb-1">Total Users</h3>
      <p class="text-3xl font-bold text-slate-800"><%= stats.usersCount %></p>
    </div>
  </div>

  <!-- Stat Card: Doctors -->
  <div class="glass-card rounded-2xl p-6 relative overflow-hidden group hover:-translate-y-1 transition-all duration-300">
    <div class="absolute top-0 right-0 -mr-8 -mt-8 w-32 h-32 rounded-full bg-emerald-500/10 blur-2xl group-hover:bg-emerald-500/20 transition-all"></div>
    <div class="flex items-center justify-between mb-4 relative z-10">
      <div class="w-12 h-12 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center text-xl shadow-inner">
        <i class="fas fa-user-md"></i>
      </div>
      <span class="text-sm font-medium text-emerald-500 bg-emerald-50 px-2.5 py-1 rounded-full"><i class="fas fa-arrow-up text-xs mr-1"></i> verified</span>
    </div>
    <div class="relative z-10">
      <h3 class="text-slate-500 text-sm font-medium mb-1">Total Doctors</h3>
      <p class="text-3xl font-bold text-slate-800"><%= stats.doctorsCount %></p>
    </div>
  </div>

  <!-- Stat Card: Shops -->
  <div class="glass-card rounded-2xl p-6 relative overflow-hidden group hover:-translate-y-1 transition-all duration-300">
    <div class="absolute top-0 right-0 -mr-8 -mt-8 w-32 h-32 rounded-full bg-amber-500/10 blur-2xl group-hover:bg-amber-500/20 transition-all"></div>
    <div class="flex items-center justify-between mb-4 relative z-10">
      <div class="w-12 h-12 rounded-xl bg-amber-100 text-amber-600 flex items-center justify-center text-xl shadow-inner">
        <i class="fas fa-store"></i>
      </div>
      <span class="text-sm font-medium text-emerald-500 bg-emerald-50 px-2.5 py-1 rounded-full"><i class="fas fa-arrow-up text-xs mr-1"></i> growing</span>
    </div>
    <div class="relative z-10">
      <h3 class="text-slate-500 text-sm font-medium mb-1">Pet Shops</h3>
      <p class="text-3xl font-bold text-slate-800"><%= stats.shopsCount %></p>
    </div>
  </div>

  <!-- Stat Card: KYC -->
  <div class="glass-card rounded-2xl p-6 relative overflow-hidden group hover:-translate-y-1 transition-all duration-300">
    <div class="absolute top-0 right-0 -mr-8 -mt-8 w-32 h-32 rounded-full bg-rose-500/10 blur-2xl group-hover:bg-rose-500/20 transition-all"></div>
    <div class="flex items-center justify-between mb-4 relative z-10">
      <div class="w-12 h-12 rounded-xl bg-rose-100 text-rose-600 flex items-center justify-center text-xl shadow-inner">
        <i class="fas fa-id-card"></i>
      </div>
      <% if(stats.kycPendingCount > 0) { %>
        <span class="text-sm font-medium text-rose-500 bg-rose-50 px-2.5 py-1 rounded-full animate-pulse">Action req.</span>
      <% } else { %>
        <span class="text-sm font-medium text-slate-500 bg-slate-100 px-2.5 py-1 rounded-full">Clear</span>
      <% } %>
    </div>
    <div class="relative z-10">
      <h3 class="text-slate-500 text-sm font-medium mb-1">Pending KYC</h3>
      <p class="text-3xl font-bold text-slate-800"><%= stats.kycPendingCount %></p>
    </div>
  </div>

  <!-- Stat Card: Appointments -->
  <div class="glass-card rounded-2xl p-6 relative overflow-hidden group hover:-translate-y-1 transition-all duration-300">
    <div class="absolute top-0 right-0 -mr-8 -mt-8 w-32 h-32 rounded-full bg-indigo-500/10 blur-2xl group-hover:bg-indigo-500/20 transition-all"></div>
    <div class="flex items-center justify-between mb-4 relative z-10">
      <div class="w-12 h-12 rounded-xl bg-indigo-100 text-indigo-600 flex items-center justify-center text-xl shadow-inner">
        <i class="fas fa-calendar-check"></i>
      </div>
    </div>
    <div class="relative z-10">
      <h3 class="text-slate-500 text-sm font-medium mb-1">Total Appointments</h3>
      <p class="text-3xl font-bold text-slate-800"><%= stats.totalAppointments %></p>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
