<!-- Top Navbar -->
<header class="h-20 bg-white/80 backdrop-blur-md border-b border-slate-200/50 flex items-center justify-between px-4 md:px-8 z-10 sticky top-0 w-full shadow-sm">
  <!-- Left Side: Mobile Menu Button & Breadcrumb -->
  <div class="flex items-center gap-4">
    <button id="mobileMenuBtn" class="p-2 -ml-2 rounded-lg text-slate-500 hover:bg-slate-100 lg:hidden focus:outline-none focus:ring-2 focus:ring-brand-500 transition-colors">
      <i class="fas fa-bars text-xl"></i>
    </button>
    <h1 class="text-xl md:text-2xl font-semibold text-slate-800 hidden sm:block"><%= title %></h1>
  </div>

  <!-- Right Side: Actions & Profile -->
  <div class="flex items-center gap-4 md:gap-6">
    <!-- Notification Bell -->
    <button class="relative p-2 text-slate-400 hover:text-slate-600 transition-colors rounded-full hover:bg-slate-100">
      <i class="far fa-bell text-xl"></i>
      <span class="absolute top-1.5 right-1.5 w-2 h-2 bg-red-500 rounded-full border-2 border-white"></span>
    </button>
    
    <div class="h-8 w-px bg-slate-200 hidden sm:block"></div>
    
    <!-- Logout Button -->
    <a href="/auth/logout" class="flex items-center gap-2 px-4 py-2 text-sm font-medium text-red-600 bg-red-50 hover:bg-red-100 rounded-xl transition-colors">
      <i class="fas fa-sign-out-alt"></i>
      <span class="hidden sm:block">Logout</span>
    </a>
  </div>
</header>
