<%- include('partials/header') %>

<div class="glass-card rounded-2xl border border-slate-200 overflow-hidden shadow-sm">
  <div class="p-6 border-b border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h2 class="text-xl font-bold text-slate-800">Monitor Products</h2>
      <p class="text-sm text-slate-500 mt-1">View all products listed across all pet shops.</p>
    </div>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm whitespace-nowrap">
      <thead class="bg-slate-50 text-slate-600 font-medium border-b border-slate-200">
        <tr>
          <th class="px-6 py-4">Product</th>
          <th class="px-6 py-4">Category</th>
          <th class="px-6 py-4">Shop</th>
          <th class="px-6 py-4">Price / Stock</th>
          <th class="px-6 py-4">Status</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% if(products && products.length > 0) { %>
          <% products.forEach(prod => { %>
            <tr class="hover:bg-slate-50/50 transition-colors">
              <td class="px-6 py-4">
                <div class="flex items-center gap-3">
                  <div class="w-12 h-12 rounded-xl bg-slate-100 overflow-hidden border border-slate-200 shrink-0">
                    <% if(prod.images && prod.images.length > 0) { %>
                      <img src="<%= prod.images[0] %>" alt="<%= prod.name %>" class="w-full h-full object-cover">
                    <% } else { %>
                      <div class="w-full h-full flex items-center justify-center text-slate-400">
                        <i class="fas fa-box"></i>
                      </div>
                    <% } %>
                  </div>
                  <div>
                    <p class="font-semibold text-slate-800 max-w-[200px] truncate" title="<%= prod.name %>"><%= prod.name %></p>
                    <span class="text-xs text-slate-500">ID: <%= prod._id.toString().substring(0,8) %>...</span>
                  </div>
                </div>
              </td>
              <td class="px-6 py-4">
                <% if(prod.category) { %>
                  <span class="px-2.5 py-1 bg-indigo-50 text-indigo-700 rounded-md text-xs font-medium"><%= prod.category.name %></span>
                <% } else { %>
                  <span class="text-slate-400">N/A</span>
                <% } %>
              </td>
              <td class="px-6 py-4">
                <% if(prod.shop) { %>
                  <p class="font-medium text-slate-700"><%= prod.shop.shopName %></p>
                <% } else { %>
                  <span class="text-slate-400">N/A</span>
                <% } %>
              </td>
              <td class="px-6 py-4">
                <p class="font-bold text-slate-700">₹<%= prod.price %></p>
                <p class="text-xs text-slate-500 mt-0.5">Stock: <span class="<%= prod.stock > 10 ? 'text-emerald-600' : 'text-rose-600' %> font-medium"><%= prod.stock %></span></p>
              </td>
              <td class="px-6 py-4">
                <% if(prod.isActive) { %>
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Active
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-rose-50 text-rose-700 border border-rose-200">
                    <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> Inactive
                  </span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="5" class="px-6 py-12 text-center text-slate-500">
              <i class="fas fa-box-open text-4xl mb-3 text-slate-300"></i>
              <p>No products found</p>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
