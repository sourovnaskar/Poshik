<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= Title %> — Poshik</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      min-height: 100vh;
      display: flex;
      background: #f0fdf9;
    }

    .left-panel {
      display: none;
      width: 45%;
      background: linear-gradient(135deg, #064e3b 0%, #065f46 35%, #047857 65%, #059669 100%);
      position: relative;
      overflow: hidden;
      flex-direction: column;
      justify-content: space-between;
      padding: 3rem;
    }
    @media (min-width: 900px) { .left-panel { display: flex; } }

    .left-panel::before {
      content: '';
      position: absolute;
      inset: 0;
      background: url('https://images.unsplash.com/photo-1552053831-71594a27632d?w=800&auto=format&fit=crop&q=60') center/cover;
      opacity: 0.12;
    }
    .left-panel-dots {
      position: absolute; inset: 0;
      background-image: radial-gradient(circle, rgba(255,255,255,0.08) 1px, transparent 1px);
      background-size: 30px 30px;
    }
    .left-panel-blob {
      position: absolute;
      width: 350px; height: 350px;
      background: rgba(16,185,129,0.15);
      border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
      bottom: -80px; right: -80px;
      animation: blob 10s ease-in-out infinite;
    }
    @keyframes blob {
      0%,100% { border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%; }
      50%      { border-radius: 40% 60% 60% 40% / 30% 70% 30% 70%; }
    }
    .panel-logo { position: relative; z-index: 1; display: flex; align-items: center; gap: 12px; }
    .panel-logo-icon {
      width: 44px; height: 44px; border-radius: 12px;
      background: rgba(255,255,255,0.2);
      display: flex; align-items: center; justify-content: center; font-size: 22px;
    }
    .panel-logo span { font-size: 26px; font-weight: 800; color: #fff; letter-spacing: -0.5px; }
    .panel-body { position: relative; z-index: 1; }
    .panel-body h2 { font-size: 2.2rem; font-weight: 800; color: #fff; line-height: 1.2; letter-spacing: -0.04em; margin-bottom: 1rem; }
    .panel-body p { color: rgba(255,255,255,0.7); font-size: 1rem; line-height: 1.7; }
    .trust-badges { position: relative; z-index: 1; }
    .trust-badge {
      display: inline-flex; align-items: center; gap: 8px;
      background: rgba(255,255,255,0.12);
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 50rem; padding: 8px 16px;
      color: rgba(255,255,255,0.85); font-size: 0.82rem; font-weight: 600;
      margin-right: 8px; margin-bottom: 8px;
    }

    .right-panel {
      flex: 1;
      display: flex; align-items: center; justify-content: center;
      padding: 2rem 1.5rem;
      overflow-y: auto;
    }
    .form-box { width: 100%; max-width: 440px; }

    .mobile-logo { display: flex; align-items: center; gap: 10px; margin-bottom: 1.5rem; }
    @media (min-width: 900px) { .mobile-logo { display: none; } }
    .mobile-logo-icon {
      width: 38px; height: 38px; border-radius: 10px;
      background: linear-gradient(135deg, #059669, #10b981);
      display: flex; align-items: center; justify-content: center; font-size: 18px; color: #fff;
    }
    .mobile-logo span { font-size: 22px; font-weight: 800; color: #064e3b; letter-spacing: -0.5px; }

    .form-title { font-size: 1.75rem; font-weight: 800; color: #111827; letter-spacing: -0.04em; margin-bottom: 4px; }
    .form-subtitle { color: #6b7280; font-size: 0.9rem; margin-bottom: 1.5rem; }

    .alert {
      border-radius: 10px; padding: 12px 16px;
      font-size: 0.86rem; margin-bottom: 1.1rem;
      display: flex; align-items: flex-start; gap: 10px;
    }
    .alert-success { background: #f0fdf4; border: 1px solid #bbf7d0; color: #166534; }
    .alert-error   { background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; }
    .alert i { margin-top: 1px; flex-shrink: 0; }

    .form-group { margin-bottom: 1rem; }
    .form-label { display: block; font-size: 0.82rem; font-weight: 700; color: #374151; margin-bottom: 5px; }
    .form-input {
      display: block; width: 100%;
      padding: 11px 14px;
      border: 1.5px solid #e5e7eb; border-radius: 10px;
      font-size: 0.92rem; font-family: inherit; color: #111827;
      background: #fff;
      transition: border-color 0.2s, box-shadow 0.2s;
      outline: none;
    }
    .form-input:focus { border-color: #10b981; box-shadow: 0 0 0 3px rgba(16,185,129,0.12); }
    .form-input::placeholder { color: #9ca3af; }

    .pass-wrap { position: relative; }
    .pass-toggle {
      position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
      background: none; border: none; cursor: pointer;
      color: #9ca3af; font-size: 15px; padding: 4px; transition: color 0.2s;
    }
    .pass-toggle:hover { color: #059669; }

    /* Role selector cards */
    .role-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 6px; }
    .role-card {
      border: 1.5px solid #e5e7eb; border-radius: 10px;
      padding: 10px 8px; text-align: center; cursor: pointer;
      transition: border-color 0.2s, background 0.2s;
    }
    .role-card:hover { border-color: #10b981; background: #f0fdf4; }
    .role-card input[type="radio"] { display: none; }
    .role-card input:checked ~ .role-label { color: #059669; }
    .role-card:has(input:checked) { border-color: #10b981; background: #f0fdf4; }
    .role-icon { font-size: 1.4rem; margin-bottom: 4px; }
    .role-label { font-size: 0.75rem; font-weight: 700; color: #374151; display: block; }

    /* File input */
    .file-input-wrapper {
      border: 1.5px dashed #d1d5db; border-radius: 10px;
      padding: 16px; text-align: center;
      cursor: pointer; transition: border-color 0.2s, background 0.2s;
    }
    .file-input-wrapper:hover { border-color: #10b981; background: #f0fdf4; }
    .file-input-wrapper input { display: none; }
    .file-input-wrapper label { cursor: pointer; color: #6b7280; font-size: 0.85rem; }
    .file-input-wrapper .file-icon { font-size: 1.5rem; color: #d1d5db; margin-bottom: 6px; }
    #fileName { font-size: 0.78rem; color: #059669; margin-top: 4px; display: block; }

    .btn-submit {
      width: 100%; padding: 13px;
      background: linear-gradient(135deg, #059669, #10b981);
      color: #fff; border: none; border-radius: 10px;
      font-size: 0.95rem; font-weight: 700; cursor: pointer; margin-top: 0.5rem;
      box-shadow: 0 6px 20px rgba(16,185,129,0.35);
      transition: transform 0.15s, box-shadow 0.15s;
    }
    .btn-submit:hover { transform: translateY(-1px); box-shadow: 0 10px 28px rgba(16,185,129,0.45); }

    .form-footer { margin-top: 1.25rem; text-align: center; font-size: 0.85rem; color: #6b7280; }
    .form-footer a { color: #059669; font-weight: 700; text-decoration: none; }
    .form-footer a:hover { text-decoration: underline; }

    /* Hidden select fallback */
    .role-select-fallback { display: none; }
  </style>
</head>
<body>

  <!-- Left Panel -->
  <div class="left-panel">
    <div class="left-panel-dots"></div>
    <div class="left-panel-blob"></div>
    <div class="panel-logo">
      <div class="panel-logo-icon">🐾</div>
      <span>Poshik</span>
    </div>
    <div class="panel-body">
      <h2>Join India's pet care community.</h2>
      <p>Manage your pets, book certified vets, and find premium supplies — all from one powerful platform designed for pet families.</p>
    </div>
    <div class="trust-badges">
      <span class="trust-badge"><i class="fas fa-user-check"></i> Free to Join</span>
      <span class="trust-badge"><i class="fas fa-lock"></i> Secure & Private</span>
      <span class="trust-badge"><i class="fas fa-paw"></i> 10k+ Pet Families</span>
    </div>
  </div>

  <!-- Right Panel -->
  <div class="right-panel">
    <div class="form-box">

      <div class="mobile-logo">
        <div class="mobile-logo-icon">🐾</div>
        <span>Poshik</span>
      </div>

      <h1 class="form-title">Create your account</h1>
      <p class="form-subtitle">Start your pet care journey today. It's free!</p>

      <!-- Flash Messages -->
      <% if (typeof successMsg !== 'undefined' && successMsg.length > 0) { %>
        <div class="alert alert-success"><i class="fas fa-check-circle"></i><span><%= successMsg %></span></div>
      <% } %>
      <% if (typeof errorMsg !== 'undefined' && errorMsg.length > 0) { %>
        <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i><span><%= errorMsg %></span></div>
      <% } %>

      <form action="/auth/register-create" method="POST" enctype="multipart/form-data">

        <div class="form-group">
          <label class="form-label" for="name">Full Name</label>
          <input type="text" id="name" name="name" class="form-input" placeholder="John Doe" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="email">Email Address</label>
          <input type="email" id="email" name="email" class="form-input" placeholder="john@example.com" required>
        </div>

        <!-- Role selector -->
        <div class="form-group">
          <label class="form-label">I am a…</label>
          <div class="role-grid">
            <label class="role-card" onclick="setRole('Owner')">
              <input type="radio" name="_role_display" value="Owner">
              <div class="role-icon">🐾</div>
              <span class="role-label">Pet Owner</span>
            </label>
            <label class="role-card" onclick="setRole('Doctor')">
              <input type="radio" name="_role_display" value="Doctor">
              <div class="role-icon">🩺</div>
              <span class="role-label">Veterinarian</span>
            </label>
            <label class="role-card" onclick="setRole('Shop')">
              <input type="radio" name="_role_display" value="Shop">
              <div class="role-icon">🏪</div>
              <span class="role-label">Shop Owner</span>
            </label>
          </div>
          <!-- Hidden select that actually submits -->
          <select name="role" id="roleSelect" required style="position:absolute;opacity:0;pointer-events:none;">
            <option value="" disabled selected></option>
            <option value="Owner">Pet owner</option>
            <option value="Doctor">Doctor</option>
            <option value="Shop">Shop Owner</option>
          </select>
        </div>

        <!-- Profile image -->
        <div class="form-group">
          <label class="form-label">Profile Picture <span style="color:#9ca3af;font-weight:400;">(optional)</span></label>
          <div class="file-input-wrapper" onclick="document.getElementById('image').click()">
            <div class="file-icon"><i class="fas fa-cloud-upload-alt"></i></div>
            <label>Click to upload a photo</label>
            <span id="fileName">No file chosen</span>
            <input type="file" id="image" name="image" accept="image/*" onchange="showFileName(this)">
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="password">Password</label>
          <div class="pass-wrap">
            <input type="password" id="password" name="password" class="form-input" placeholder="Min. 6 characters" required style="padding-right:40px;">
            <button type="button" class="pass-toggle" onclick="togglePass('password', this)"><i class="fas fa-eye"></i></button>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="confirmPassword">Confirm Password</label>
          <div class="pass-wrap">
            <input type="password" id="confirmPassword" name="confirmPassword" class="form-input" placeholder="Repeat password" required style="padding-right:40px;">
            <button type="button" class="pass-toggle" onclick="togglePass('confirmPassword', this)"><i class="fas fa-eye"></i></button>
          </div>
        </div>

        <button type="submit" class="btn-submit">Create Account →</button>

      </form>

      <p class="form-footer">
        Already have an account? <a href="/auth/login">Sign in</a>
      </p>
    </div>
  </div>

  <script>
    function setRole(val) {
      document.getElementById('roleSelect').value = val;
    }
    function showFileName(input) {
      document.getElementById('fileName').textContent = input.files[0] ? input.files[0].name : 'No file chosen';
    }
    function togglePass(inputId, btn) {
      const input = document.getElementById(inputId);
      const icon = btn.querySelector('i');
      input.type = input.type === 'password' ? 'text' : 'password';
      icon.className = input.type === 'password' ? 'fas fa-eye' : 'fas fa-eye-slash';
    }
  </script>

</body>
</html>