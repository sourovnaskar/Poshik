<%- include('./partials/header') %>
    <%- include('./partials/navbar') %>

    <style>
        .detail-card {
            border: none;
            border-radius: 1rem;
            box-shadow: 0 2px 16px rgba(0,0,0,0.07);
        }
        .info-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            padding: 0.6rem 0;
            border-bottom: 1px solid #f1f3f5;
            font-size: 0.9rem;
        }
        .info-row:last-child { border-bottom: none; }
        .product-img {
            width: 56px; height: 56px;
            object-fit: cover;
            border-radius: 0.5rem;
            flex-shrink: 0;
        }
        .status-badge {
            font-size: 0.8rem;
            font-weight: 600;
            padding: 0.35em 0.9em;
            border-radius: 50rem;
        }
        .status-select {
            border-radius: 0.5rem;
            border: 2px solid #dee2e6;
            padding: 0.5rem 0.75rem;
            font-weight: 600;
            cursor: pointer;
            transition: border-color 0.2s;
        }
        .status-select:focus { border-color: #0d6efd; outline: none; box-shadow: 0 0 0 0.15rem rgba(13,110,253,.15); }
        .update-btn {
            background: linear-gradient(135deg, #0d6efd, #6f42c1);
            border: none;
            transition: opacity 0.2s, transform 0.15s;
        }
        .update-btn:hover { opacity: 0.9; transform: translateY(-1px); }

        /* Timeline */
        .timeline { list-style: none; padding: 0; margin: 0; }
        .timeline-item { display: flex; gap: 1rem; padding-bottom: 1.25rem; position: relative; }
        .timeline-item:last-child { padding-bottom: 0; }
        .timeline-item:not(:last-child)::before {
            content: '';
            position: absolute;
            left: 11px; top: 24px;
            width: 2px; height: calc(100% - 4px);
            background: #dee2e6;
        }
        .timeline-dot {
            width: 24px; height: 24px;
            border-radius: 50%;
            flex-shrink: 0;
            display: flex; align-items: center; justify-content: center;
            font-size: 0.7rem;
            font-weight: 700;
            border: 2px solid;
        }
        .dot-done   { background: #d1e7dd; color: #0f5132; border-color: #0f5132; }
        .dot-active { background: #0d6efd; color: white; border-color: #0d6efd; }
        .dot-idle   { background: #f8f9fa; color: #adb5bd; border-color: #dee2e6; }
    </style>

    <div class="container-fluid">
        <div class="row">
            <%- include('./partials/sidebar') %>

            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4 bg-light min-vh-100">

                <%- include('./partials/flash') %>

                <!-- Breadcrumb -->
                <nav aria-label="breadcrumb" class="mb-3">
                    <ol class="breadcrumb small">
                        <li class="breadcrumb-item"><a href="/shop/orders" class="text-decoration-none">Orders</a></li>
                        <li class="breadcrumb-item active text-muted">#<%= order.orderNumber %></li>
                    </ol>
                </nav>

                <!-- Page Header -->
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
                    <div>
                        <h1 class="h3 fw-bold text-dark mb-1">Order #<%= order.orderNumber %></h1>
                        <p class="text-muted small mb-0">
                            Placed on <%= new Date(order.createdAt).toLocaleDateString('en-IN', {weekday:'long', day:'numeric', month:'long', year:'numeric'}) %>
                        </p>
                    </div>
                    <span class="badge status-badge
                        <% if (order.orderStatus === 'Pending') { %>bg-warning-subtle text-warning border border-warning-subtle
                        <% } else if (order.orderStatus === 'Confirmed') { %>bg-info-subtle text-info border border-info-subtle
                        <% } else if (order.orderStatus === 'Processing') { %>bg-primary-subtle text-primary border border-primary-subtle
                        <% } else if (order.orderStatus === 'Shipped') { %>bg-secondary-subtle text-secondary border border-secondary-subtle
                        <% } else if (order.orderStatus === 'Delivered') { %>bg-success-subtle text-success border border-success-subtle
                        <% } else { %>bg-danger-subtle text-danger border border-danger-subtle
                        <% } %>">
                        <%= order.orderStatus %>
                    </span>
                </div>

                <div class="row g-4">

                    <!-- ── Left Column ── -->
                    <div class="col-lg-8">

                        <!-- Ordered Items -->
                        <div class="bg-white detail-card p-4 mb-4">
                            <h6 class="fw-bold text-uppercase text-muted small mb-3">
                                <i class="bi bi-box-seam me-1 text-primary"></i>Items Ordered
                            </h6>
                            <div class="d-flex flex-column gap-3">
                                <% order.items.forEach(item => { %>
                                    <div class="d-flex align-items-center gap-3 py-2 border-bottom last-no-border">
                                        <% if (item.product && item.product.images && item.product.images.length > 0) { %>
                                            <img src="<%= item.product.images[0] %>" alt="<%= item.productName %>" class="product-img border">
                                        <% } else { %>
                                            <div class="product-img bg-light border d-flex align-items-center justify-content-center text-muted">
                                                <i class="bi bi-box fs-4"></i>
                                            </div>
                                        <% } %>
                                        <div class="flex-grow-1">
                                            <div class="fw-semibold"><%= item.productName %></div>
                                            <div class="text-muted small">Qty: <%= item.quantity %> &times; ₹<%= item.price %></div>
                                        </div>
                                        <div class="fw-bold text-success">₹<%= item.subtotal %></div>
                                    </div>
                                <% }) %>
                            </div>

                            <!-- Price Summary -->
                            <div class="mt-3 pt-3 border-top">
                                <div class="info-row">
                                    <span class="text-muted">Subtotal</span>
                                    <span>₹<%= order.totalAmount - 20 %></span>
                                </div>
                                <div class="info-row">
                                    <span class="text-muted">Platform Fee</span>
                                    <span>₹20</span>
                                </div>
                                <div class="d-flex justify-content-between fw-bold fs-5 pt-2">
                                    <span>Total</span>
                                    <span class="text-success">₹<%= order.totalAmount %></span>
                                </div>
                            </div>
                        </div>

                        <!-- Customer & Shipping -->
                        <div class="bg-white detail-card p-4">
                            <div class="row g-4">
                                <!-- Customer -->
                                <div class="col-md-5">
                                    <h6 class="fw-bold text-uppercase text-muted small mb-3">
                                        <i class="bi bi-person-fill me-1 text-primary"></i>Customer
                                    </h6>
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="<%= order.user && order.user.profileImage ? order.user.profileImage : 'https://ui-avatars.com/?name=' + encodeURIComponent(order.user ? order.user.name : 'User') + '&background=0d6efd&color=fff' %>"
                                             alt="Customer" width="44" height="44" class="rounded-circle object-fit-cover border">
                                        <div>
                                            <div class="fw-semibold"><%= order.user ? order.user.name : 'Unknown' %></div>
                                            <div class="text-muted small"><%= order.user ? order.user.email : '' %></div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Shipping Address -->
                                <div class="col-md-7">
                                    <h6 class="fw-bold text-uppercase text-muted small mb-3">
                                        <i class="bi bi-geo-alt-fill me-1 text-primary"></i>Delivery Address
                                    </h6>
                                    <div class="info-row">
                                        <span class="text-muted">Name</span>
                                        <span class="fw-medium"><%= order.shippingAddress.name %></span>
                                    </div>
                                    <div class="info-row">
                                        <span class="text-muted">Phone</span>
                                        <span><%= order.shippingAddress.phone %></span>
                                    </div>
                                    <div class="info-row">
                                        <span class="text-muted">Address</span>
                                        <span class="text-end" style="max-width:60%;">
                                            <%= order.shippingAddress.address %>,
                                            <%= order.shippingAddress.city %>,
                                            <%= order.shippingAddress.state %> - <%= order.shippingAddress.postalCode %>
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <!-- Payment -->
                            <div class="border-top mt-3 pt-3">
                                <h6 class="fw-bold text-uppercase text-muted small mb-3">
                                    <i class="bi bi-credit-card-fill me-1 text-primary"></i>Payment
                                </h6>
                                <div class="d-flex flex-wrap gap-4">
                                    <div>
                                        <div class="text-muted small">Method</div>
                                        <div class="fw-semibold"><%= order.paymentMethod === 'COD' ? '💵 Cash on Delivery' : '💳 Online' %></div>
                                    </div>
                                    <div>
                                        <div class="text-muted small">Payment Status</div>
                                        <span class="badge rounded-pill
                                            <% if (order.paymentStatus === 'Paid') { %>bg-success-subtle text-success border border-success-subtle
                                            <% } else if (order.paymentStatus === 'Failed') { %>bg-danger-subtle text-danger border border-danger-subtle
                                            <% } else { %>bg-warning-subtle text-warning border border-warning-subtle<% } %>">
                                            <%= order.paymentStatus %>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ── Right Column ── -->
                    <div class="col-lg-4">

                        <!-- Update Status -->
                        <div class="bg-white detail-card p-4 mb-4">
                            <h6 class="fw-bold text-uppercase text-muted small mb-3">
                                <i class="bi bi-pencil-square me-1 text-primary"></i>Update Order Status
                            </h6>

                            <%
                                const progressOrder = ['Pending','Confirmed','Processing','Shipped','Delivered'];
                                const isTerminal = (order.orderStatus === 'Delivered' || order.orderStatus === 'Cancelled');
                                const curIdx = progressOrder.indexOf(order.orderStatus);
                                // Forward options = statuses AFTER current one in the chain, + Cancelled (unless already delivered/cancelled)
                                const allowedOptions = progressOrder.filter((s, i) => i > curIdx);
                                if (!isTerminal) allowedOptions.push('Cancelled');
                            %>

                            <% if (isTerminal) { %>
                                <!-- Terminal state — locked -->
                                <div class="alert mb-0 d-flex align-items-start gap-2
                                    <%= order.orderStatus === 'Delivered' ? 'alert-success' : 'alert-danger' %>
                                    border-0 rounded-3" style="font-size:0.9rem;">
                                    <i class="bi <%= order.orderStatus === 'Delivered' ? 'bi-check-circle-fill text-success' : 'bi-x-circle-fill text-danger' %> fs-5 flex-shrink-0 mt-1"></i>
                                    <div>
                                        <div class="fw-bold mb-1">Order <%= order.orderStatus %></div>
                                        <div class="opacity-75 small">
                                            <% if (order.orderStatus === 'Delivered') { %>
                                                This order has been delivered and is now closed. No further status changes are allowed.
                                            <% } else { %>
                                                This order was cancelled. No further status changes are allowed.
                                            <% } %>
                                        </div>
                                    </div>
                                </div>

                            <% } else { %>
                                <!-- Active order — show only forward options -->
                                <% if (allowedOptions.length === 0) { %>
                                    <p class="text-muted small mb-0">No further status changes available.</p>
                                <% } else { %>
                                    <!-- Hint: what comes next -->
                                    <% const nextStatus = progressOrder[curIdx + 1]; %>
                                    <% if (nextStatus) { %>
                                        <div class="d-flex align-items-center gap-2 mb-3 p-2 rounded-2 bg-primary-subtle">
                                            <i class="bi bi-arrow-right-circle-fill text-primary"></i>
                                            <span class="small fw-medium text-primary">Next step: <strong><%= nextStatus %></strong></span>
                                        </div>
                                    <% } %>

                                    <form action="/shop/orders/<%= order._id %>/status" method="POST">
                                        <div class="mb-3">
                                            <label class="form-label small fw-semibold text-muted">Move order to:</label>
                                            <select name="orderStatus" class="form-select status-select w-100">
                                                <% allowedOptions.forEach(s => { %>
                                                    <option value="<%= s %>"
                                                        class="<%= s === 'Cancelled' ? 'text-danger' : '' %>"
                                                    ><%= s %><%= s === 'Cancelled' ? ' ⚠️' : '' %></option>
                                                <% }) %>
                                            </select>
                                            <div class="form-text">
                                                <i class="bi bi-info-circle me-1"></i>Current: <strong><%= order.orderStatus %></strong>. You can only move forward.
                                            </div>
                                        </div>
                                        <button type="submit" class="btn btn-primary update-btn w-100 fw-bold rounded-pill text-white shadow-sm">
                                            <i class="bi bi-check-circle-fill me-2"></i>Update Status
                                        </button>
                                    </form>
                                <% } %>
                            <% } %>
                        </div>

                        <!-- Order Timeline -->
                        <div class="bg-white detail-card p-4">
                            <h6 class="fw-bold text-uppercase text-muted small mb-4">
                                <i class="bi bi-clock-history me-1 text-primary"></i>Order Progress
                            </h6>
                            <%
                                const allStatuses = ['Pending','Confirmed','Processing','Shipped','Delivered'];
                                // For Cancelled, we show separately
                                const isCancelled = order.orderStatus === 'Cancelled';
                                const currentIdx = isCancelled ? -1 : allStatuses.indexOf(order.orderStatus);
                            %>
                            <ul class="timeline">
                                <% allStatuses.forEach((s, idx) => {
                                    let dotClass = 'dot-idle';
                                    let icon = (idx + 1).toString();
                                    if (isCancelled) {
                                        dotClass = 'dot-idle';
                                    } else if (idx < currentIdx) {
                                        dotClass = 'dot-done'; icon = '✓';
                                    } else if (idx === currentIdx) {
                                        dotClass = 'dot-active'; icon = '●';
                                    }
                                %>
                                    <li class="timeline-item">
                                        <div class="timeline-dot <%= dotClass %>"><%= icon %></div>
                                        <div style="padding-top:2px;">
                                            <div class="fw-semibold small <%= idx <= currentIdx && !isCancelled ? 'text-dark' : 'text-muted' %>"><%= s %></div>
                                            <% if (idx === currentIdx && !isCancelled) { %>
                                                <div class="text-primary" style="font-size:0.72rem;">Current Status</div>
                                            <% } %>
                                        </div>
                                    </li>
                                <% }) %>
                                <% if (isCancelled) { %>
                                    <li class="timeline-item">
                                        <div class="timeline-dot" style="background:#ffe0e0; color:#dc3545; border-color:#dc3545;">✕</div>
                                        <div style="padding-top:2px;">
                                            <div class="fw-semibold small text-danger">Cancelled</div>
                                            <div class="text-danger" style="font-size:0.72rem;">Order was cancelled</div>
                                        </div>
                                    </li>
                                <% } %>
                            </ul>
                        </div>

                    </div>
                </div>

            </main>
        </div>
    </div>

<%- include('./partials/footer') %>
