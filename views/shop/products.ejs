<%- include('./partials/header') %>
    <%- include('./partials/navbar') %>

        <div class="container-fluid">
            <div class="row">
                <!-- Include Sidebar -->
                <%- include('./partials/sidebar') %>

                    <!-- Main Content Area -->
                    <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4 bg-light min-vh-100">

                        <!-- Page Header -->
                        <div
                            class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-4 gap-3">
                            <div>
                                <h1 class="h3 fw-bold text-dark mb-1">My Products</h1>
                                <p class="text-muted small mb-0">Manage your inventory, pricing, and stock levels.</p>
                            </div>
                            <a href="/api/shop/products" class="btn btn-primary fw-bold shadow-sm">
                                <i class="bi bi-plus-lg me-1"></i> Add New Product
                            </a>
                        </div>

                        <!-- Flash Messages -->
                        <%- include('./partials/flash') %>

                            <!-- Products Card / Table -->
                            <div class="card border-0 shadow-sm rounded-3">
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th scope="col" class="py-3 ps-4">Product</th>
                                                    <th scope="col" class="py-3">Category</th>
                                                    <th scope="col" class="py-3">Price</th>
                                                    <th scope="col" class="py-3">Stock</th>
                                                    <th scope="col" class="py-3">Status</th>
                                                    <th scope="col" class="py-3 text-end pe-4">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% if (typeof products !=='undefined' && products.length> 0) { %>
                                                    <% products.forEach((product)=> { %>
                                                        <tr>
                                                            <!-- Image and Name -->
                                                            <td class="ps-4 py-3">
                                                                <div class="d-flex align-items-center gap-3">
                                                                    <% if (product.images && product.images.length> 0) {
                                                                        %>
                                                                        <img src="<%= product.images[0] %>"
                                                                            alt="<%= product.name %>"
                                                                            class="rounded-3 object-fit-cover shadow-sm"
                                                                            width="50" height="50">
                                                                        <% } else { %>
                                                                            <div class="rounded-3 bg-light border d-flex align-items-center justify-content-center text-muted"
                                                                                style="width: 50px; height: 50px;">
                                                                                <i class="bi bi-box-seam fs-5"></i>
                                                                            </div>
                                                                            <% } %>
                                                                                <div>
                                                                                    <h6 class="mb-0 fw-bold text-dark text-truncate"
                                                                                        style="max-width: 200px;">
                                                                                        <%= product.name %>
                                                                                    </h6>
                                                                                    <small class="text-muted">ID: <%=
                                                                                            product._id.toString().slice(-6).toUpperCase()
                                                                                            %></small>
                                                                                </div>
                                                                </div>
                                                            </td>

                                                            <!-- Category Name -->
                                                            <td class="text-muted fw-medium">
                                                                <%= product.category ? product.category.name
                                                                    : 'Uncategorized' %>
                                                            </td>

                                                            <!-- Pricing Logic (MRP crossed out + Selling Price) -->
                                                            <td>
                                                                <div class="d-flex flex-column">
                                                                    <span class="fw-bold text-success">₹<%=
                                                                            product.price %></span>
                                                                    <% if (product.mrp> product.price) { %>
                                                                        <small
                                                                            class="text-muted text-decoration-line-through"
                                                                            style="font-size: 0.75rem;">₹<%= product.mrp
                                                                                %></small>
                                                                        <% } %>
                                                                </div>
                                                            </td>

                                                            <!-- Stock Level with dynamic colors -->
                                                            <td>
                                                                <% if (product.stock> 10) { %>
                                                                    <span class="fw-bold text-dark">
                                                                        <%= product.stock %>
                                                                    </span>
                                                                    <% } else if (product.stock> 0) { %>
                                                                        <span class="fw-bold text-warning">
                                                                            <%= product.stock %> (Low)
                                                                        </span>
                                                                        <% } else { %>
                                                                            <span class="badge bg-danger">Out of
                                                                                Stock</span>
                                                                            <% } %>
                                                            </td>

                                                            <!-- Active / Inactive Status -->
                                                            <td>
                                                                <% if (product.isActive) { %>
                                                                    <span
                                                                        class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1">Active</span>
                                                                    <% } else { %>
                                                                        <span
                                                                            class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2 py-1">Draft</span>
                                                                        <% } %>
                                                            </td>

                                                            <!-- Actions -->
                                                            <td class="text-end pe-4">
                                                                <div class="btn-group shadow-sm">
                                                                    <a href="/api/shop/products/edit/<%= product._id %>"
                                                                        class="btn btn-sm btn-light border"
                                                                        title="Edit">
                                                                        <i class="bi bi-pencil"></i>
                                                                    </a>
                                                                    <form
                                                                        action="/api/shop/products/delete/<%= product._id %>"
                                                                        method="POST" class="d-inline"
                                                                        onsubmit="return confirm('Delete this product?');">
                                                                        <button type="submit"
                                                                            class="btn btn-sm btn-light border text-danger"
                                                                            title="Delete">
                                                                            <i class="bi bi-trash"></i>
                                                                        </button>
                                                                    </form>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                        <% }) %>
                                                            <% } else { %>
                                                                <tr>
                                                                    <td colspan="6" class="text-center py-5">
                                                                        <i
                                                                            class="bi bi-box-seam display-4 text-muted opacity-25 d-block mb-3"></i>
                                                                        <h5 class="fw-bold text-dark mb-1">No Products
                                                                            Yet</h5>
                                                                        <p class="text-muted small mb-3">Start building
                                                                            your inventory by adding your first product.
                                                                        </p>
                                                                        <a href="/api/shop/products"
                                                                            class="btn btn-sm btn-primary fw-medium">Add
                                                                            First Product</a>
                                                                    </td>
                                                                </tr>
                                                                <% } %>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <!-- Pagination & Footer -->
                            <% if (typeof products !=='undefined' && products.length> 0) { %>
                                <div
                                    class="d-flex flex-column flex-md-row justify-content-between align-items-center mt-4 gap-3">
                                    <div class="text-muted small">
                                        Showing <strong>
                                            <%= ((currentPage - 1) * limit) + 1 %>
                                        </strong> to
                                        <strong>
                                            <%= Math.min(currentPage * limit, totalProducts) %>
                                        </strong> of
                                        <strong>
                                            <%= totalProducts %>
                                        </strong> products
                                    </div>

                                    <% if (totalPages> 1) { %>
                                        <nav aria-label="Products pagination">
                                            <ul class="pagination pagination-sm mb-0 shadow-sm">
                                                <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                                                    <a class="page-link text-dark" href="?page=<%= currentPage - 1 %>"
                                                        tabindex="-1">Previous</a>
                                                </li>
                                                <% for (let i=1; i <=totalPages; i++) { %>
                                                    <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                                                        <a class="page-link <%= currentPage === i ? 'bg-primary border-primary' : 'text-dark' %>"
                                                            href="?page=<%= i %>">
                                                            <%= i %>
                                                        </a>
                                                    </li>
                                                    <% } %>
                                                        <li
                                                            class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                                                            <a class="page-link text-dark"
                                                                href="?page=<%= currentPage + 1 %>">Next</a>
                                                        </li>
                                            </ul>
                                        </nav>
                                        <% } %>
                                </div>
                                <% } %>

                    </main>
            </div>
        </div>

        <%- include('./partials/footer') %>