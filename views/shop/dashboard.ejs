<%- include('./partials/header') %>
    <%- include('./partials/navbar') %>

        <!-- Load Chart.js for Professional Graphs -->
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

        <div class="container-fluid">
            <div class="row">
                <!-- Include Sidebar -->
                <%- include('./partials/sidebar') %>

                    <!-- Main Content Area -->
                    <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4 bg-light min-vh-100">

                        <!-- Flash Messages -->
                        <%- include('./partials/flash') %>

                            <!-- ========================================== -->
                            <!-- DYNAMIC KYC & PROFILE NOTIFICATION BANNERS -->
                            <!-- ========================================== -->
                            <% if (user.kycStatus==='Not Submitted' ) { %>
                                <div
                                    class="alert alert-danger d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 shadow-sm border-0 border-start border-danger border-4">
                                    <div>
                                        <h5 class="alert-heading fw-bold mb-1 text-danger">⚠️ Action Required: Account
                                            Restricted</h5>
                                        <p class="mb-0 text-danger opacity-75 small">Complete your KYC to list your shop
                                            and start receiving orders.</p>
                                    </div>
                                    <a href="/shop/kyc/form"
                                        class="btn btn-danger mt-3 mt-sm-0 fw-bold text-nowrap shadow-sm">
                                        Complete KYC Now
                                    </a>
                                </div>
                                <% } else if (user.kycStatus==='Pending' ) { %>
                                    <div
                                        class="alert alert-warning mb-4 shadow-sm border-0 border-start border-warning border-4">
                                        <h5 class="alert-heading fw-bold mb-1 text-dark">⏳ Documents Under Review</h5>
                                        <p class="mb-0 text-dark opacity-75 small">We are verifying your KYC documents.
                                            This usually takes 24-48 hours. You will be notified once approved.</p>
                                    </div>
                                    <% } else if (user.kycStatus==='Rejected' ) { %>
                                        <div
                                            class="alert alert-danger d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 shadow-sm border-0 border-start border-danger border-4">
                                            <div>
                                                <h5 class="alert-heading fw-bold mb-1 text-danger">❌ KYC Rejected</h5>
                                                <p class="mb-0 text-danger opacity-75 small">Reason: <%= typeof
                                                        rejectionReason !=='undefined' ? rejectionReason
                                                        : 'Invalid documents provided. Please ensure images are clear.'
                                                        %>
                                                </p>
                                            </div>
                                            <a href="/shop/kyc/form"
                                                class="btn btn-danger mt-3 mt-sm-0 fw-bold text-nowrap shadow-sm">
                                                Resubmit Documents
                                            </a>
                                        </div>
                                        <% } else if (user.kycStatus==='Approved' && !hasProfile) { %>
                                            <div
                                                class="alert alert-primary d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 shadow-sm border-0 border-start border-primary border-4">
                                                <div>
                                                    <h5 class="alert-heading fw-bold mb-1 text-primary">🎉 KYC Approved!
                                                        Final Step</h5>
                                                    <p class="mb-0 text-primary opacity-75 small">Set up your shop
                                                        details, description, and logo to start selling.</p>
                                                </div>
                                                <a href="/shop/details/form"
                                                    class="btn btn-primary mt-3 mt-sm-0 fw-bold text-nowrap shadow-sm">
                                                    Create Profile Now
                                                </a>
                                            </div>
                                            <% } %>

                                                <!-- ========================================== -->
                                                <!-- DASHBOARD WIDGETS (Locked/Blurred Logic)   -->
                                                <!-- ========================================== -->
                                                <% const isLocked=(user.kycStatus !=='Approved' || !hasProfile); %>

                                                    <div class="position-relative">
                                                        <!-- LOCK OVERLAY -->
                                                        <% if (isLocked) { %>
                                                            <div class="position-absolute top-0 start-0 w-100 h-100 d-flex flex-column align-items-center justify-content-center z-3"
                                                                style="backdrop-filter: blur(6px); border-radius: 0.5rem;">
                                                                <div class="text-center mt-5 pt-5">
                                                                    <span class="display-1 d-block mb-3">🔒</span>
                                                                    <p
                                                                        class="bg-white text-dark fw-bold fs-5 px-4 py-3 rounded-3 shadow-sm border d-inline-block mx-3">
                                                                        Unlock your dashboard by verifying KYC and
                                                                        completing your shop profile
                                                                    </p>
                                                                </div>
                                                            </div>
                                                            <% } %>

                                                                <!-- MAIN CONTENT WRAPPER -->
                                                                <div class="<% if(isLocked) { %>opacity-50<% } %>" <%
                                                                    if(isLocked) { %>style="pointer-events: none;"<% }
                                                                        %>>

                                                                        <!-- Welcome Header -->
                                                                        <div
                                                                            class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between mb-4 gap-3">
                                                                            <h1 class="h3 fw-bold text-dark mb-0">
                                                                                Welcome, <%= (typeof hasProfile
                                                                                    !=='undefined' && hasProfile &&
                                                                                    shop) ? shop.shopName :
                                                                                    user.name.split(' ')[0] %>
                        </h1>
                        
                        <% if (user.kycStatus === ' Approved' && typeof hasProfile !=='undefined' && hasProfile) { %>
                                                                                    <span
                                                                                        class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2 fw-medium fs-6 shadow-sm">
                                                                                        <i
                                                                                            class="bi bi-check-circle-fill me-1"></i>
                                                                                        Verified Seller
                                                                                    </span>
                                                                                    <% } %>
                                                                        </div>

                                                                        <!-- 1. Top Metrics Grid -->
                                                                        <div class="row g-3 mb-4">
                                                                            <!-- Revenue -->
                                                                            <div class="col-12 col-sm-6 col-xl-3">
                                                                                <div
                                                                                    class="bg-white p-4 rounded-3 shadow-sm border-0 h-100 border-start border-success border-4">
                                                                                    <h6 class="text-muted text-uppercase fw-bold mb-2"
                                                                                        style="font-size: 0.75rem; letter-spacing: 0.05em;">
                                                                                        Total Revenue</h6>
                                                                                    <p
                                                                                        class="display-6 fw-bold text-dark mb-0">
                                                                                        ₹<%= typeof totalRevenue
                                                                                            !=='undefined' ?
                                                                                            totalRevenue : '0.00' %>
                                                                                    </p>
                                                                                </div>
                                                                            </div>
                                                                            <!-- Active Orders -->
                                                                            <div class="col-12 col-sm-6 col-xl-3">
                                                                                <div
                                                                                    class="bg-white p-4 rounded-3 shadow-sm border-0 h-100 border-start border-primary border-4">
                                                                                    <h6 class="text-muted text-uppercase fw-bold mb-2"
                                                                                        style="font-size: 0.75rem; letter-spacing: 0.05em;">
                                                                                        Active Orders</h6>
                                                                                    <p
                                                                                        class="display-6 fw-bold text-dark mb-0">
                                                                                        <%= typeof activeOrders
                                                                                            !=='undefined' ?
                                                                                            activeOrders : '0' %>
                                                                                    </p>
                                                                                </div>
                                                                            </div>
                                                                            <!-- Products -->
                                                                            <!-- Products -->
                                                                            <div class="col-12 col-sm-6 col-xl-3">
                                                                                <div
                                                                                    class="bg-white p-4 rounded-3 shadow-sm border-0 h-100 border-start border-info border-4 d-flex flex-column justify-content-between">
                                                                                    <div>
                                                                                        <h6 class="text-muted text-uppercase fw-bold mb-2"
                                                                                            style="font-size: 0.75rem; letter-spacing: 0.05em;">
                                                                                            Listed Products</h6>
                                                                                        <p
                                                                                            class="display-6 fw-bold text-dark mb-0">
                                                                                            <%= typeof totalProducts
                                                                                                !=='undefined' ?
                                                                                                totalProducts : '0' %>
                                                                                        </p>
                                                                                    </div>
                                                                                    <a href="/shop/get/categories"
                                                                                        class="text-decoration-none small fw-bold text-info mt-3 d-inline-block">
                                                                                        Manage Categories <i
                                                                                            class="bi bi-arrow-right"></i>
                                                                                    </a>
                                                                                </div>
                                                                            </div>
                                                                            <!-- Pending Dispatch -->
                                                                            <div class="col-12 col-sm-6 col-xl-3">
                                                                                <div
                                                                                    class="bg-white p-4 rounded-3 shadow-sm border-0 h-100 border-start border-warning border-4">
                                                                                    <h6 class="text-muted text-uppercase fw-bold mb-2"
                                                                                        style="font-size: 0.75rem; letter-spacing: 0.05em;">
                                                                                        Pending Dispatch</h6>
                                                                                    <p
                                                                                        class="display-6 fw-bold text-dark mb-0">
                                                                                        <%= typeof pendingDispatch
                                                                                            !=='undefined' ?
                                                                                            pendingDispatch : '0' %>
                                                                                    </p>
                                                                                </div>
                                                                            </div>
                                                                        </div>

                                                                        <!-- 2. Charts Section -->
                                                                        <div class="row g-4 mb-4">
                                                                            <!-- Revenue Line Chart -->
                                                                            <div class="col-12 col-lg-8">
                                                                                <div
                                                                                    class="bg-white p-4 rounded-3 shadow-sm border-0 h-100">
                                                                                    <h5 class="fw-bold mb-4 text-dark">
                                                                                        Revenue Overview</h5>
                                                                                    <div
                                                                                        style="position: relative; height:300px; width:100%">
                                                                                        <canvas
                                                                                            id="revenueChart"></canvas>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                            <!-- Order Status Doughnut Chart -->
                                                                            <div class="col-12 col-lg-4">
                                                                                <div
                                                                                    class="bg-white p-4 rounded-3 shadow-sm border-0 h-100">
                                                                                    <h5 class="fw-bold mb-4 text-dark">
                                                                                        Orders by Status</h5>
                                                                                    <div style="position: relative; height:300px; width:100%"
                                                                                        class="d-flex justify-content-center">
                                                                                        <canvas
                                                                                            id="orderStatusChart"></canvas>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                        </div>

                                                                        <!-- 3. Recent Orders Table -->
                                                                        <div
                                                                            class="bg-white p-4 rounded-3 shadow-sm border-0 mb-4">
                                                                            <div
                                                                                class="d-flex justify-content-between align-items-center mb-4">
                                                                                <h5 class="fw-bold mb-0 text-dark">
                                                                                    Recent Orders</h5>
                                                                                <a href="/shop/orders"
                                                                                    class="btn btn-sm btn-outline-primary">View
                                                                                    All</a>
                                                                            </div>
                                                                            <div class="table-responsive">
                                                                                <table
                                                                                    class="table table-hover align-middle mb-0">
                                                                                    <thead class="table-light">
                                                                                        <tr>
                                                                                            <th scope="col"
                                                                                                class="text-muted fw-semibold py-3">
                                                                                                Order ID</th>
                                                                                            <th scope="col"
                                                                                                class="text-muted fw-semibold py-3">
                                                                                                Customer</th>
                                                                                            <th scope="col"
                                                                                                class="text-muted fw-semibold py-3">
                                                                                                Amount</th>
                                                                                            <th scope="col"
                                                                                                class="text-muted fw-semibold py-3">
                                                                                                Status</th>
                                                                                            <th scope="col"
                                                                                                class="text-muted fw-semibold py-3 text-end">
                                                                                                Action</th>
                                                                                        </tr>
                                                                                    </thead>
                                                                                    <tbody>
                                                                                        <!-- Fallback for empty state until controller feeds data -->
                                                                                        <% if (typeof recentOrders
                                                                                            !=='undefined' &&
                                                                                            recentOrders.length> 0) { %>
                                                                                            <%
                                                                                                recentOrders.forEach(order=>
                                                                                                { %>
                                                                                                <tr>
                                                                                                    <td
                                                                                                        class="fw-medium">
                                                                                                        #<%= order.orderId
                                                                                                            %>
                                                                                                    </td>
                                                                                                    <td>
                                                                                                        <%= order.customerName
                                                                                                            %>
                                                                                                    </td>
                                                                                                    <td
                                                                                                        class="fw-bold text-success">
                                                                                                        ₹<%= order.amount
                                                                                                            %>
                                                                                                    </td>
                                                                                                    <td>
                                                                                                        <span
                                                                                                            class="badge bg-warning-subtle text-warning border border-warning-subtle">
                                                                                                            <%= order.status
                                                                                                                %>
                                                                                                        </span>
                                                                                                    </td>
                                                                                                    <td
                                                                                                        class="text-end">
                                                                                                        <a href="/shop/orders/<%= order._id %>"
                                                                                                            class="btn btn-sm btn-light border shadow-sm">Process</a>
                                                                                                    </td>
                                                                                                </tr>
                                                                                                <% }) %>
                                                                                                    <% } else { %>
                                                                                                        <tr>
                                                                                                            <td colspan="5"
                                                                                                                class="text-center py-5">
                                                                                                                <i
                                                                                                                    class="bi bi-inboxes text-muted opacity-25 display-4 d-block mb-3"></i>
                                                                                                                <p
                                                                                                                    class="text-muted mb-0">
                                                                                                                    No
                                                                                                                    recent
                                                                                                                    orders
                                                                                                                    found.
                                                                                                                </p>
                                                                                                            </td>
                                                                                                        </tr>
                                                                                                        <% } %>
                                                                                    </tbody>
                                                                                </table>
                                                                            </div>
                                                                        </div>

                                                                </div> <!-- End of blurred content wrapper -->
                                                    </div> <!-- End of relative positioning wrapper -->
                    </main>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- CHART.JS INITIALIZATION SCRIPT             -->
        <!-- ========================================== -->
        <script>
            document.addEventListener("DOMContentLoaded", function () {

                // ── Real data injected by the server ─────────────────────────
                const revenueLabels = <%- JSON.stringify(revenueLabels) %>;
                const revenueData   = <%- JSON.stringify(revenueData) %>;
                // [Pending, Confirmed, Processing, Shipped, Delivered, Cancelled]
                const orderStats    = <%- JSON.stringify(orderStats) %>;
                // ─────────────────────────────────────────────────────────────

                // 1. LINE CHART — Revenue last 7 days
                const ctxRev = document.getElementById('revenueChart').getContext('2d');
                const hasRevenueData = revenueData.some(v => v > 0);

                new Chart(ctxRev, {
                    type: 'line',
                    data: {
                        labels: revenueLabels,
                        datasets: [{
                            label: 'Revenue (₹)',
                            data: revenueData,
                            borderColor: '#0d6efd',
                            backgroundColor: 'rgba(13, 110, 253, 0.08)',
                            borderWidth: 3,
                            tension: 0.4,
                            fill: true,
                            pointBackgroundColor: '#fff',
                            pointBorderColor: '#0d6efd',
                            pointBorderWidth: 2,
                            pointRadius: 5,
                            pointHoverRadius: 7
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: ctx => ' ₹' + ctx.parsed.y.toLocaleString('en-IN')
                                }
                            },
                            // Show "No revenue yet" when all values are 0
                            ...(hasRevenueData ? {} : {
                                afterDraw: chart => {
                                    const { ctx: c, width, height } = chart;
                                    c.save();
                                    c.textAlign = 'center';
                                    c.textBaseline = 'middle';
                                    c.fillStyle = '#adb5bd';
                                    c.font = '14px Inter, sans-serif';
                                    c.fillText('No delivered orders in the last 7 days', width / 2, height / 2);
                                    c.restore();
                                }
                            })
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                grid: { borderDash: [5, 5], color: '#e9ecef' },
                                ticks: {
                                    callback: v => '₹' + v.toLocaleString('en-IN')
                                }
                            },
                            x: { grid: { display: false } }
                        }
                    }
                });

                // 2. DOUGHNUT CHART — Orders by status (all 6 statuses)
                const statusLabels = ['Pending', 'Confirmed', 'Processing', 'Shipped', 'Delivered', 'Cancelled'];
                const statusColors = [
                    '#ffc107',  // Pending    — amber
                    '#0dcaf0',  // Confirmed  — cyan
                    '#0d6efd',  // Processing — blue
                    '#6f42c1',  // Shipped    — purple
                    '#198754',  // Delivered  — green
                    '#dc3545',  // Cancelled  — red
                ];

                const totalOrders = orderStats.reduce((a, b) => a + b, 0);
                const ctxOrders = document.getElementById('orderStatusChart').getContext('2d');

                new Chart(ctxOrders, {
                    type: 'doughnut',
                    data: {
                        labels: statusLabels,
                        datasets: [{
                            data: orderStats,
                            backgroundColor: statusColors,
                            borderWidth: 2,
                            borderColor: '#fff',
                            hoverOffset: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '72%',
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    padding: 16,
                                    usePointStyle: true,
                                    pointStyleWidth: 10,
                                    font: { size: 12 },
                                    // Hide statuses that have 0 orders to keep legend clean
                                    filter: (item, data) => data.datasets[0].data[item.index] > 0
                                }
                            },
                            tooltip: {
                                callbacks: {
                                    label: ctx => {
                                        const val = ctx.parsed;
                                        const pct = totalOrders > 0 ? ((val / totalOrders) * 100).toFixed(1) : 0;
                                        return ` ${ctx.label}: ${val} (${pct}%)`;
                                    }
                                }
                            }
                        }
                    },
                    // Center label showing total
                    plugins: [{
                        id: 'centerText',
                        afterDraw(chart) {
                            const { ctx: c, width, height, chartArea } = chart;
                            if (!chartArea) return;
                            const cx = (chartArea.left + chartArea.right) / 2;
                            const cy = (chartArea.top + chartArea.bottom) / 2;
                            c.save();
                            if (totalOrders === 0) {
                                c.textAlign = 'center';
                                c.textBaseline = 'middle';
                                c.fillStyle = '#adb5bd';
                                c.font = '13px Inter, sans-serif';
                                c.fillText('No orders yet', cx, cy);
                            } else {
                                c.textAlign = 'center';
                                c.textBaseline = 'middle';
                                c.fillStyle = '#1a1a2e';
                                c.font = 'bold 22px Inter, sans-serif';
                                c.fillText(totalOrders, cx, cy - 8);
                                c.fillStyle = '#6c757d';
                                c.font = '12px Inter, sans-serif';
                                c.fillText('Total Orders', cx, cy + 14);
                            }
                            c.restore();
                        }
                    }]
                });
            });
        </script>

        <%- include('./partials/footer') %>
