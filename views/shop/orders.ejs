<%- include('./partials/header') %>
    <%- include('./partials/navbar') %>

    <div class="container-fluid">
        <div class="row">
            <%- include('./partials/sidebar') %>

            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4 bg-light min-vh-100">

                <%- include('./partials/flash') %>

                <!-- Page Header -->
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
                    <div>
                        <h1 class="h3 fw-bold text-dark mb-1">Orders</h1>
                        <p class="text-muted small mb-0"><%= totalOrders %> total order<%= totalOrders !== 1 ? 's' : '' %></p>
                    </div>

                    <!-- Status Filter -->
                    <form method="GET" action="/shop/orders" class="d-flex gap-2 align-items-center">
                        <select name="status" class="form-select form-select-sm" style="min-width:150px;" onchange="this.form.submit()">
                            <option value="">All Statuses</option>
                            <% ['Pending','Confirmed','Processing','Shipped','Delivered','Cancelled'].forEach(s => { %>
                                <option value="<%= s %>" <%= statusFilter === s ? 'selected' : '' %>><%= s %></option>
                            <% }) %>
                        </select>
                    </form>
                </div>

                <!-- Orders Table -->
                <div class="bg-white rounded-3 shadow-sm border-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light border-bottom">
                                <tr>
                                    <th class="py-3 text-muted fw-semibold small text-uppercase">Order #</th>
                                    <th class="py-3 text-muted fw-semibold small text-uppercase">Customer</th>
                                    <th class="py-3 text-muted fw-semibold small text-uppercase">Items</th>
                                    <th class="py-3 text-muted fw-semibold small text-uppercase">Total</th>
                                    <th class="py-3 text-muted fw-semibold small text-uppercase">Date</th>
                                    <th class="py-3 text-muted fw-semibold small text-uppercase">Status</th>
                                    <th class="py-3 text-muted fw-semibold small text-uppercase text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (!orders || orders.length === 0) { %>
                                    <tr>
                                        <td colspan="7" class="text-center py-5">
                                            <i class="bi bi-inboxes text-muted opacity-25 display-4 d-block mb-3"></i>
                                            <p class="text-muted mb-0">
                                                <% if (statusFilter) { %>
                                                    No orders with status "<%= statusFilter %>".
                                                    <a href="/shop/orders" class="text-decoration-none">Clear filter</a>
                                                <% } else { %>
                                                    No orders yet. Share your shop to start receiving orders!
                                                <% } %>
                                            </p>
                                        </td>
                                    </tr>
                                <% } else { %>
                                    <% orders.forEach(order => { %>
                                        <tr>
                                            <td class="fw-medium">#<%= order.orderNumber %></td>
                                            <td>
                                                <div class="fw-semibold small"><%= order.user ? order.user.name : 'Unknown' %></div>
                                                <div class="text-muted" style="font-size:0.75rem;"><%= order.user ? order.user.email : '' %></div>
                                            </td>
                                            <td class="text-muted small"><%= order.items.length %> item<%= order.items.length !== 1 ? 's' : '' %></td>
                                            <td class="fw-bold text-success">₹<%= order.totalAmount %></td>
                                            <td class="text-muted small">
                                                <%= new Date(order.createdAt).toLocaleDateString('en-IN', {day:'numeric', month:'short', year:'numeric'}) %>
                                            </td>
                                            <td>
                                                <span class="badge rounded-pill
                                                    <% if (order.orderStatus === 'Pending') { %>bg-warning-subtle text-warning border border-warning-subtle
                                                    <% } else if (order.orderStatus === 'Confirmed') { %>bg-info-subtle text-info border border-info-subtle
                                                    <% } else if (order.orderStatus === 'Processing') { %>bg-primary-subtle text-primary border border-primary-subtle
                                                    <% } else if (order.orderStatus === 'Shipped') { %>bg-secondary-subtle text-secondary border border-secondary-subtle
                                                    <% } else if (order.orderStatus === 'Delivered') { %>bg-success-subtle text-success border border-success-subtle
                                                    <% } else { %>bg-danger-subtle text-danger border border-danger-subtle
                                                    <% } %>" style="font-size:0.75rem; padding: 0.35em 0.8em; font-weight:600;">
                                                    <%= order.orderStatus %>
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                <a href="/shop/orders/<%= order._id %>"
                                                   class="btn btn-sm btn-light border shadow-sm rounded-pill px-3">
                                                    <i class="bi bi-eye me-1"></i>View
                                                </a>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Pagination -->
                <% if (totalPages > 1) { %>
                    <nav class="mt-4 d-flex justify-content-center">
                        <ul class="pagination">
                            <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                                <a class="page-link rounded-start-pill" href="?page=<%= currentPage - 1 %>&status=<%= statusFilter %>">‹</a>
                            </li>
                            <% for (let i = 1; i <= totalPages; i++) { %>
                                <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                                    <a class="page-link" href="?page=<%= i %>&status=<%= statusFilter %>"><%= i %></a>
                                </li>
                            <% } %>
                            <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                                <a class="page-link rounded-end-pill" href="?page=<%= currentPage + 1 %>&status=<%= statusFilter %>">›</a>
                            </li>
                        </ul>
                    </nav>
                <% } %>

            </main>
        </div>
    </div>

<%- include('./partials/footer') %>
