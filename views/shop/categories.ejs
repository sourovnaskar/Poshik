<%- include('./partials/header') %>
    <%- include('./partials/navbar') %>

        <div class="container-fluid">
            <div class="row">
                <!-- Include Sidebar -->
                <%- include('./partials/sidebar') %>

                    <!-- Main Content Area -->
                    <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4 bg-light min-vh-100">

                        <!-- Page Header -->
                        <div
                            class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-4 gap-3">
                            <div>
                                <h1 class="h3 fw-bold text-dark mb-1">Product Categories</h1>
                                <p class="text-muted small mb-0">Manage and organize the categories for your products.
                                </p>
                            </div>
                            <a href="/shop/categories" class="btn btn-primary fw-bold shadow-sm">
                                <i class="bi bi-plus-lg me-1"></i> Add New Category
                            </a>
                        </div>

                        <!-- Flash Messages -->
                        <%- include('./partials/flash') %>

                            <!-- Categories Card / Table -->
                            <div class="card border-0 shadow-sm rounded-3">
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th scope="col" class="py-3 ps-4">Image</th>
                                                    <th scope="col" class="py-3">Category Name</th>
                                                    <th scope="col" class="py-3">Status</th>
                                                    <th scope="col" class="py-3">Created At</th>
                                                    <th scope="col" class="py-3 text-end pe-4">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% if (typeof categories !=='undefined' && categories.length> 0) { %>
                                                    <% categories.forEach((cat, index)=> { %>
                                                        <tr>
                                                            <td class="ps-4 py-3">
                                                                <% if (cat.image) { %>
                                                                    <img src="<%= cat.image %>" alt="<%= cat.name %>"
                                                                        class="rounded-3 object-fit-cover shadow-sm"
                                                                        width="48" height="48">
                                                                    <% } else { %>
                                                                        <div class="rounded-3 bg-light border d-flex align-items-center justify-content-center text-muted"
                                                                            style="width: 48px; height: 48px;">
                                                                            <i class="bi bi-tag fs-5"></i>
                                                                        </div>
                                                                        <% } %>
                                                            </td>
                                                            <td class="fw-bold text-dark">
                                                                <%= cat.name %>
                                                            </td>
                                                            <td>
                                                                <% if (cat.isActive) { %>
                                                                    <span
                                                                        class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1">Active</span>
                                                                    <% } else { %>
                                                                        <span
                                                                            class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-1">Inactive</span>
                                                                        <% } %>
                                                            </td>
                                                            <td class="text-muted small">
                                                                <%= cat.createdAt.toLocaleDateString('en-IN', {
                                                                    day: 'numeric' , month: 'short' , year: 'numeric' })
                                                                    %>
                                                            </td>
                                                            <td class="text-end pe-4">
                                                                <!-- Optional: Delete or Edit buttons -->
                                                                <form
                                                                    action="/shop/categories/delete/<%= cat._id %>"
                                                                    method="POST" class="d-inline"
                                                                    onsubmit="return confirm('Are you sure you want to delete this category?');">
                                                                    <button type="submit"
                                                                        class="btn btn-sm btn-outline-danger border-0 shadow-sm"
                                                                        title="Delete Category">
                                                                        <i class="bi bi-trash"></i>
                                                                    </button>
                                                                </form>
                                                            </td>
                                                        </tr>
                                                        <% }) %>
                                                            <% } else { %>
                                                                <tr>
                                                                    <td colspan="5" class="text-center py-5">
                                                                        <i
                                                                            class="bi bi-tags display-4 text-muted opacity-25 d-block mb-3"></i>
                                                                        <h5 class="fw-bold text-dark mb-1">No Categories
                                                                            Found</h5>
                                                                        <p class="text-muted small mb-3">You haven't
                                                                            created any categories for your shop yet.
                                                                        </p>
                                                                        <a href="/shop/categories"
                                                                            class="btn btn-sm btn-primary fw-medium">Create
                                                                            Your First Category</a>
                                                                    </td>
                                                                </tr>
                                                                <% } %>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <!-- Category Count Footer Notice -->
                            <!-- ========================================== -->
                            <!-- PAGINATION & FOOTER                        -->
                            <!-- ========================================== -->
                            <% if (typeof categories !=='undefined' && categories.length> 0) { %>
                                <div
                                    class="d-flex flex-column flex-md-row justify-content-between align-items-center mt-4 gap-3">

                                    <!-- Showing X to Y of Z Text -->
                                    <div class="text-muted small">
                                        Showing <strong>
                                            <%= ((currentPage - 1) * limit) + 1 %>
                                        </strong> to
                                        <strong>
                                            <%= Math.min(currentPage * limit, totalCategories) %>
                                        </strong> of
                                        <strong>
                                            <%= totalCategories %>
                                        </strong> categories
                                    </div>

                                    <!-- Bootstrap Pagination Controls -->
                                    <% if (totalPages> 1) { %>
                                        <nav aria-label="Categories pagination">
                                            <ul class="pagination pagination-sm mb-0 shadow-sm">

                                                <!-- Previous Button -->
                                                <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                                                    <a class="page-link text-dark" href="?page=<%= currentPage - 1 %>"
                                                        tabindex="-1">Previous</a>
                                                </li>

                                                <!-- Page Numbers -->
                                                <% for (let i=1; i <=totalPages; i++) { %>
                                                    <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                                                        <a class="page-link <%= currentPage === i ? 'bg-primary border-primary' : 'text-dark' %>"
                                                            href="?page=<%= i %>">
                                                            <%= i %>
                                                        </a>
                                                    </li>
                                                    <% } %>

                                                        <!-- Next Button -->
                                                        <li
                                                            class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                                                            <a class="page-link text-dark"
                                                                href="?page=<%= currentPage + 1 %>">Next</a>
                                                        </li>

                                            </ul>
                                        </nav>
                                        <% } %>
                                </div>
                                <% } %>

                    </main>
            </div>
        </div>

        <%- include('./partials/footer') %>