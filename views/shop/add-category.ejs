<%- include('./partials/header') %>

<style>
    .image-preview-wrapper {
        width: 150px;
        height: 150px;
        border-radius: 12px;
        border: 2px dashed #ced4da;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background-color: #f8f9fa;
        margin-bottom: 1rem;
        position: relative;
    }
    .image-preview-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: none; /* Hidden until selected */
    }
    .image-placeholder {
        font-size: 3rem;
        color: #adb5bd;
    }
</style>

<%- include('./partials/navbar') %>

<div class="container-fluid">
    <div class="row">
        <!-- Include Sidebar -->
        <%- include('./partials/sidebar') %>

        <!-- Main Content Area -->
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4 bg-light min-vh-100">
            
            <!-- Breadcrumb / Header -->
            <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                <div>
                    <h1 class="h3 fw-bold text-dark mb-1">Add New Category</h1>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-0">
                            <li class="breadcrumb-item"><a href="/api/shop/dashboard" class="text-decoration-none">Dashboard</a></li>
                            <li class="breadcrumb-item"><a href="/api/shop/get/categories" class="text-decoration-none">Categories</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Add New</li>
                        </ol>
                    </nav>
                </div>
                <a href="/api/shop/get/categories" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to Categories
                </a>
            </div>

            <!-- Flash Messages -->
            <div class="row">
                <div class="col-lg-8 mx-auto">
                    <%- include('./partials/flash') %>
                </div>
            </div>

            <!-- Category Form Card -->
            <div class="row">
                <div class="col-lg-8 mx-auto">
                    <div class="card border-0 shadow-sm rounded-3">
                        <div class="card-body p-4 p-md-5">
                            
                            <!-- Notice the enctype for file uploads! -->
                            <form action="/api/shop/categories/add" method="POST" enctype="multipart/form-data">
                                
                                <!-- Category Name -->
                                <div class="mb-4">
                                    <label for="name" class="form-label fw-bold text-dark">Category Name <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control form-control-lg bg-light" id="name" name="name" required maxlength="100" placeholder="e.g., Dog Food, Toys, Accessories">
                                    <div class="form-text text-muted">Use a clear, concise name. Max 100 characters.</div>
                                </div>

                                <!-- Category Image -->
                                <div class="mb-4">
                                    <label class="form-label fw-bold text-dark">Category Image (Optional)</label>
                                    
                                    <div class="d-flex flex-column align-items-center p-4 border rounded-3 bg-light text-center">
                                        <div class="image-preview-wrapper" id="previewWrapper">
                                            <i class="bi bi-image image-placeholder" id="placeholderIcon"></i>
                                            <img src="" alt="Category Preview" class="image-preview-img" id="imagePreview">
                                        </div>
                                        
                                        <div class="w-100" style="max-width: 300px;">
                                            <input class="form-control form-control-sm" type="file" id="image" name="image" accept=".jpg, .jpeg, .png, .webp" onchange="previewCategoryImage(event)">
                                            <div class="form-text small mt-2">Square image (1:1 ratio) recommended.</div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Submit Button -->
                                <div class="d-grid mt-5">
                                    <button type="submit" class="btn btn-primary btn-lg fw-bold shadow-sm">
                                        <i class="bi bi-plus-circle me-2"></i> Create Category
                                    </button>
                                </div>

                            </form>
                        </div>
                    </div>
                </div>
            </div>

        </main>
    </div>
</div>

<!-- Image Preview Script -->
<script>
    function previewCategoryImage(event) {
        const input = event.target;
        const preview = document.getElementById('imagePreview');
        const placeholderIcon = document.getElementById('placeholderIcon');

        if (input.files && input.files[0]) {
            const reader = new FileReader();
            
            reader.onload = function(e) {
                preview.src = e.target.result;
                preview.style.display = 'block';
                placeholderIcon.style.display = 'none';
            }
            
            reader.readAsDataURL(input.files[0]);
        } else {
            preview.src = "";
            preview.style.display = 'none';
            placeholderIcon.style.display = 'block';
        }
    }
</script>

<%- include('./partials/footer') %>