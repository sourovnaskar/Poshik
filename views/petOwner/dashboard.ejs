<%- include('./partials/header', { title: 'Dashboard' }) %>
<%- include('./partials/sidebar') %>
<%- include('./partials/navbar') %>

<main class="main-content">
    <div class="container-fluid py-3">
        
        <!-- Quick Stats Row (Fully Responsive) -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-md-4">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-3 p-md-4 d-flex align-items-center">
                        <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3">
                            <i class="fa-solid fa-dog text-primary fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 text-uppercase small fw-bold">My Pets</h6>
                            <h3 class="mb-0 fw-bold"><%= petsCount || 0 %></h3>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-12 col-md-4">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-3 p-md-4 d-flex align-items-center">
                        <div class="bg-success bg-opacity-10 p-3 rounded-circle me-3">
                            <i class="fa-solid fa-box text-success fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 text-uppercase small fw-bold">Active Orders</h6>
                            <h3 class="mb-0 fw-bold"><%= activeOrdersCount || 0 %></h3>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-12 col-md-4">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-3 p-md-4 d-flex align-items-center">
                        <div class="bg-warning bg-opacity-10 p-3 rounded-circle me-3">
                            <i class="fa-solid fa-stethoscope text-warning fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 text-uppercase small fw-bold">Appointments</h6>
                            <h3 class="mb-0 fw-bold"><%= upcomingAppointmentsCount || 0 %></h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <% if (petsCount === 0) { %>
            <!-- ZERO STATE: Call to Action / First Time User Section -->
            <div class="row">
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-4 p-md-5 text-center">
                            <img src="https://cdn-icons-png.flaticon.com/512/3551/3551523.png" alt="Welcome" style="width: 100px; opacity: 0.8;" class="mb-3 img-fluid">
                            <h4 class="fw-bold">Ready to manage your pet's needs?</h4>
                            <p class="text-muted mb-4">Start by adding your pet's profile, browse products from approved pet shops, or book a veterinary consultation.</p>
                            
                            <div class="d-flex flex-column flex-md-row justify-content-center gap-2">
                                <a href="/api/pet/add" class="btn btn-primary px-4 py-2 shadow-sm">
                                    <i class="fa-solid fa-plus me-2"></i>Add a Pet
                                </a>
                                <a href="/marketplace/shops" class="btn btn-outline-dark px-4 py-2 shadow-sm">
                                    <i class="fa-solid fa-shop me-2"></i>Visit Marketplace
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        <% } else { %>
            <!-- ACTIVE STATE: Dashboard for Users with Pets -->
            <div class="row g-4">
                
                <!-- Left Column: Pets and Appointments -->
                <div class="col-12 col-lg-8 d-flex flex-column gap-4">
                    
                    <!-- My Pets Section -->
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center pt-4 pb-0 px-4">
                            <h5 class="fw-bold mb-0">My Furry Friends</h5>
                            <a href="/api/pet/add" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-plus"></i> Add New</a>
                        </div>
                        <div class="card-body p-4">
                            <div class="row g-3">
                                <% pets.forEach(pet => { %>
                                    <div class="col-12 col-sm-6 col-md-4">
                                        <div class="card h-100 border rounded-4 text-center p-3 transition-hover">
                                            <img src="<%= pet.image || '/images/default-pet.png' %>" alt="<%= pet.name %>" class="rounded-circle mx-auto mb-3 object-fit-cover" style="width: 80px; height: 80px; border: 3px solid #f4f7fa;">
                                            <h6 class="fw-bold mb-1"><%= pet.name %></h6>
                                            <p class="text-muted small mb-3"><%= pet.breed || pet.species %></p>
                                            <a href="/api/pet/profile/<%= pet._id %>" class="btn btn-sm btn-light w-100 rounded-pill text-primary fw-medium">View Profile</a>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        </div>
                    </div>

                    <!-- Upcoming Appointments Section -->
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-header bg-white border-0 pt-4 pb-0 px-4">
                            <h5 class="fw-bold mb-0">Upcoming Vet Visits</h5>
                        </div>
                        <div class="card-body p-4">
                            <% if (upcomingAppointments && upcomingAppointments.length > 0) { %>
                                <div class="list-group list-group-flush">
                                    <% upcomingAppointments.forEach(appt => { %>
                                        <div class="list-group-item px-0 py-3 d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center border-bottom">
                                            <div class="d-flex align-items-center mb-2 mb-sm-0">
                                                <div class="bg-warning bg-opacity-10 p-3 rounded-3 me-3 text-warning">
                                                    <i class="fa-solid fa-calendar-day fs-5"></i>
                                                </div>
                                                <div>
                                                    <h6 class="fw-bold mb-1">Dr. <%= appt.doctorName %></h6>
                                                    <small class="text-muted">For <%= appt.petName %> • <%= new Date(appt.date).toLocaleDateString() %> at <%= appt.time %></small>
                                                </div>
                                            </div>
                                            <span class="badge bg-primary rounded-pill px-3 py-2">Confirmed</span>
                                        </div>
                                    <% }) %>
                                </div>
                            <% } else { %>
                                <div class="text-center py-4">
                                    <p class="text-muted mb-3">No upcoming appointments scheduled.</p>
                                    <a href="/appointments/book" class="btn btn-outline-secondary btn-sm rounded-pill px-4">Book a Vet</a>
                                </div>
                            <% } %>
                        </div>
                    </div>

                </div>

                <!-- Right Column: Recent Orders & Quick Links -->
                <div class="col-12 col-lg-4 d-flex flex-column gap-4">
                    
                    <!-- Recent Orders Widget -->
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-header bg-white border-0 pt-4 pb-0 px-4 d-flex justify-content-between align-items-center">
                            <h5 class="fw-bold mb-0">Recent Order</h5>
                            <a href="/owner/orders" class="text-decoration-none small">View All</a>
                        </div>
                        <div class="card-body p-4">
                            <% if (recentOrders && recentOrders.length > 0) { %>
                                <% const latestOrder = recentOrders[0]; %>
                                <div class="border rounded-4 p-3 bg-light">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <span class="fw-bold text-dark">#<%= latestOrder.orderNumber %></span>
                                        <!-- Real-time status target element for Socket.io -->
                                        <span class="badge bg-info text-dark rounded-pill" id="status-<%= latestOrder._id %>">
                                            <%= latestOrder.orderStatus %>
                                        </span>
                                    </div>
                                    <div class="mb-3">
                                        <small class="text-muted d-block">Shop: <strong><%= latestOrder.shopName %></strong></small>
                                        <small class="text-muted d-block">Total: <strong>₹<%= latestOrder.totalAmount %></strong></small>
                                    </div>
                                    <a href="/owner/orders/<%= latestOrder._id %>" class="btn btn-dark w-100 rounded-pill btn-sm">Track Order</a>
                                </div>
                            <% } else { %>
                                <div class="text-center py-4 border border-dashed rounded-4">
                                    <i class="fa-solid fa-basket-shopping fs-3 text-muted mb-2"></i>
                                    <p class="text-muted small mb-0">You haven't ordered anything yet.</p>
                                    <a href="/marketplace/shops" class="text-primary text-decoration-none small fw-bold mt-2 d-inline-block">Shop Now</a>
                                </div>
                            <% } %>
                        </div>
                    </div>

                    <!-- Marketplace Quick Promo -->
                    <div class="card border-0 shadow-sm rounded-4 bg-primary text-white text-center p-4">
                        <i class="fa-solid fa-store fs-1 mb-3 text-white-50"></i>
                        <h5 class="fw-bold">Poshik Marketplace</h5>
                        <p class="small text-white-50 mb-3">Get the best food, toys, and accessories from verified local shops.</p>
                        <a href="/marketplace/shops" class="btn btn-light text-primary rounded-pill fw-bold shadow-sm">Start Shopping</a>
                    </div>

                </div>
            </div>
        <% } %>

    </div>
</main>

<style>
    /* Add this to your header or main CSS file for the hover effect on pet cards */
    .transition-hover {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .transition-hover:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
    }
    /* Dashed border utility */
    .border-dashed {
        border-style: dashed !important;
    }
</style>

<%- include('./partials/footer') %>