<%- include('./partials/header', { title: 'Dashboard' }) %>
    <!-- Note: Removed the sidebar include completely -->
    <%- include('./partials/navbar') %>

        <main class="main-content flex-grow-1"
            style="background-color: #f8f9fc; min-height: calc(100vh - 76px); padding: 0;">
            <div class="container-fluid container-xl py-4 py-md-5">

                <!-- Welcome Hero Section -->
                <div class="row mb-5">
                    <div class="col-12">
                        <div class="card border-0 rounded-4 overflow-hidden shadow-sm"
                            style="background: linear-gradient(135deg, #e0eafc 0%, #cfdef3 100%);">
                            <div class="card-body p-4 p-md-5 position-relative">
                                <div class="row align-items-center">
                                    <div class="col-md-8 position-relative z-1">
                                        <h2 class="fw-bold text-dark mb-2">Welcome back, <%= typeof user !=='undefined'
                                                && user ? user.name.split(' ')[0] : ' Friend' %>! 🐾</h2>
                                        <p class="text-secondary fs-5 mb-4">What does your furry friend need today?</p>
                                        <div class="d-flex flex-wrap gap-2">
                                            <a href="/pet/view/shop"
                                                class="btn btn-primary rounded-pill px-4 py-2 fw-medium shadow">
                                                <i class="fa-solid fa-bone me-2"></i> Buy Food & Toys
                                            </a>
                                            <a href="/pet/view/book-doctor"
                                                class="btn btn-outline-dark bg-white rounded-pill px-4 py-2 fw-medium shadow-sm border-0">
                                                <i class="fa-solid fa-stethoscope me-2"></i> Book a Vet
                                            </a>
                                        </div>
                                    </div>
                                    <div class="col-md-4 d-none d-md-flex justify-content-end align-items-center">
                                        <div class="bg-white rounded-circle shadow-sm d-flex justify-content-center align-items-center"
                                            style="width: 140px; height: 140px;">
                                            <i class="fa-solid fa-dog text-primary" style="font-size: 5rem;"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <% if (petsCount===0) { %>
                    <!-- ZERO STATE: Call to Action -->
                    <div class="text-center py-5">
                        <div class="bg-white p-5 rounded-4 shadow-sm mx-auto border" style="max-width: 600px;">
                            <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex p-4 mb-4">
                                <i class="fa-solid fa-paw fs-1 text-primary"></i>
                            </div>
                            <h3 class="fw-bold mb-3">Add Your First Pet</h3>
                            <p class="text-muted mb-4 fs-5">Create a profile for your pet to start booking vets, buying
                                supplies, and tracking their health.</p>
                            <a href="/pet/add" class="btn btn-primary rounded-pill px-5 py-3 fs-5 shadow">
                                <i class="fa-solid fa-plus me-2"></i> Add Pet Profile
                            </a>
                        </div>
                    </div>
                    <% } else { %>

                        <div class="row g-4">
                            <!-- Left Column (Main Content) -->
                            <div class="col-lg-8 d-flex flex-column gap-4">

                                <!-- My Pets Section -->
                                <div>
                                    <div class="d-flex justify-content-between align-items-end mb-3">
                                        <h4 class="fw-bold mb-0">My Pets</h4>
                                        <a href="/pet/add"
                                            class="text-decoration-none fw-bold text-primary bg-primary bg-opacity-10 px-3 py-1 rounded-pill"><i
                                                class="fa-solid fa-plus me-1"></i> Add New</a>
                                    </div>

                                    <div class="row g-3">
                                        <% pets.forEach(pet=> { %>
                                            <div class="col-md-6 col-xl-4">
                                                <div class="card border-0 shadow-sm rounded-4 h-100 pet-card bg-white">
                                                    <div class="card-body p-4 text-center">
                                                        <div class="position-relative d-inline-block mb-3">
                                                            <img src="<%= pet.image || '/images/default-pet.png' %>"
                                                                alt="<%= pet.name %>"
                                                                class="rounded-circle object-fit-cover shadow-sm"
                                                                style="width: 90px; height: 90px; border: 4px solid #f8f9fc;">
                                                        </div>
                                                        <h5 class="fw-bold mb-1">
                                                            <%= pet.name %>
                                                        </h5>
                                                        <p class="text-muted small mb-3">
                                                            <%= pet.breed || pet.species %>
                                                        </p>
                                                        <a href="/pet/profile/<%= pet._id %>"
                                                            class="btn btn-sm btn-light border rounded-pill w-100 text-primary fw-medium">View
                                                            Profile</a>
                                                    </div>
                                                </div>
                                            </div>
                                            <% }) %>
                                    </div>
                                </div>

                                <!-- Upcoming Appointments -->
                                <div>
                                    <h4 class="fw-bold mb-3">Upcoming Vet Visits</h4>
                                    <div class="card border-0 shadow-sm rounded-4 bg-white">
                                        <div class="card-body p-0">
                                            <% if (upcomingAppointments && upcomingAppointments.length> 0) { %>
                                                <div class="list-group list-group-flush rounded-4">
                                                    <% upcomingAppointments.forEach(appt=> { %>
                                                        <div class="list-group-item p-4 border-bottom">
                                                            <div
                                                                class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                                                                <div class="d-flex align-items-center gap-3">
                                                                    <div class="bg-warning bg-opacity-10 text-warning rounded-4 p-3 d-flex align-items-center justify-content-center"
                                                                        style="width: 56px; height: 56px;">
                                                                        <i class="fa-solid fa-calendar-check fs-4"></i>
                                                                    </div>
                                                                    <div>
                                                                        <h6 class="fw-bold mb-1">Dr. <%= appt.doctor ? appt.doctor.name : 'Unknown' %>
                                                                        </h6>
                                                                        <p class="text-muted mb-0 small">
                                                                            <i class="fa-regular fa-clock me-1"></i>
                                                                            <%= new Date(appt.appointmentDate).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' }) %>
                                                                                <span class="mx-2">•</span>
                                                                                <i class="fa-solid fa-paw me-1"></i>
                                                                                <%= appt.pet ? appt.pet.name : 'Unknown' %>
                                                                        </p>
                                                                    </div>
                                                                </div>
                                                                <span
                                                                    class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 fw-medium border border-success border-opacity-25"><%= appt.status %></span>
                                                            </div>
                                                        </div>
                                                        <% }) %>
                                                </div>
                                                <% } else { %>
                                                    <div class="p-5 text-center">
                                                        <div class="bg-light rounded-circle d-inline-flex p-4 mb-3">
                                                            <i class="fa-regular fa-calendar-xmark fs-2 text-muted"></i>
                                                        </div>
                                                        <h6 class="fw-bold text-dark">No appointments scheduled</h6>
                                                        <p class="text-muted small mb-3">Keep your pets healthy with
                                                            regular checkups.</p>
                                                        <a href="/pet/view/book-doctor"
                                                            class="btn btn-outline-primary btn-sm rounded-pill px-4 py-2 fw-medium">Find
                                                            a Vet</a>
                                                    </div>
                                                    <% } %>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Right Column -->
                            <div class="col-lg-4 d-flex flex-column gap-4">

                                <!-- Quick Stats (More consumer friendly) -->
                                <div class="row g-3">
                                    <div class="col-6">
                                        <div class="card border-0 shadow-sm rounded-4 text-center p-3 h-100 bg-white">
                                            <div
                                                class="bg-primary bg-opacity-10 rounded-circle d-inline-flex p-3 mb-2 mx-auto">
                                                <i class="fa-solid fa-box text-primary fs-4"></i>
                                            </div>
                                            <h3 class="fw-bold mb-0">
                                                <%= activeOrdersCount || 0 %>
                                            </h3>
                                            <p class="text-muted small mb-0 fw-medium">Active Orders</p>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="card border-0 shadow-sm rounded-4 text-center p-3 h-100 bg-white">
                                            <div
                                                class="bg-warning bg-opacity-10 rounded-circle d-inline-flex p-3 mb-2 mx-auto">
                                                <i class="fa-solid fa-stethoscope text-warning fs-4"></i>
                                            </div>
                                            <h3 class="fw-bold mb-0">
                                                <%= upcomingAppointmentsCount || 0 %>
                                            </h3>
                                            <p class="text-muted small mb-0 fw-medium">Appointments</p>
                                        </div>
                                    </div>
                                </div>

                                <!-- Recent Orders Widget -->
                                <div class="card border-0 shadow-sm rounded-4 bg-white">
                                    <div
                                        class="card-header bg-white border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                                        <h5 class="fw-bold mb-0">Recent Order</h5>
                                        <a href="/pet/orders"
                                            class="text-primary text-decoration-none small fw-bold bg-primary bg-opacity-10 px-3 py-1 rounded-pill">See
                                            All</a>
                                    </div>
                                    <div class="card-body p-4">
                                        <% if (recentOrders && recentOrders.length> 0) { %>
                                            <% const latestOrder=recentOrders[0]; %>
                                                <div class="bg-light rounded-4 p-3 mb-3 border">
                                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                                        <span class="text-dark fw-bold small">#<%=
                                                                latestOrder.orderNumber %></span>
                                                        <span class="badge bg-info text-dark rounded-pill shadow-sm"
                                                            id="status-<%= latestOrder._id %>">
                                                            <%= latestOrder.orderStatus %>
                                                        </span>
                                                    </div>
                                                    <h6 class="fw-bold mb-1 text-truncate">
                                                        <%= latestOrder.shop ? latestOrder.shop.shopName : 'Unknown Shop' %>
                                                    </h6>
                                                    <p class="text-primary fw-bold mb-0 fs-5">₹<%=
                                                            latestOrder.totalAmount %>
                                                    </p>
                                                </div>
                                                <a href="/pet/orders"
                                                    class="btn btn-dark w-100 rounded-pill py-2 fw-medium shadow">Track
                                                    Package</a>
                                                <% } else { %>
                                                    <div class="text-center py-4 border border-dashed rounded-4">
                                                        <i
                                                            class="fa-solid fa-bag-shopping fs-3 text-muted mb-2 opacity-50"></i>
                                                        <p class="text-muted small mb-3">You have no recent orders.</p>
                                                        <a href="/pet/view/shop"
                                                            class="btn btn-primary btn-sm rounded-pill px-4 fw-medium">Start
                                                            Shopping</a>
                                                    </div>
                                                    <% } %>
                                    </div>
                                </div>

                                <!-- Promo Banner -->
                                <div class="card border-0 shadow-sm rounded-4 text-white overflow-hidden position-relative mt-auto"
                                    style="background: linear-gradient(45deg, #ff9a9e 0%, #fecfef 99%, #fecfef 100%);">
                                    <div class="card-body p-4 position-relative z-1 text-center py-5">
                                        <div class="bg-white rounded-circle d-inline-flex p-3 mb-3 shadow-sm">
                                            <i class="fa-solid fa-gift text-danger fs-3"></i>
                                        </div>
                                        <h5 class="fw-bold text-dark mb-2">Treat Your Pet</h5>
                                        <p class="small text-dark text-opacity-75 mb-4 fw-medium">Discover premium toys
                                            and treats in our marketplace today!</p>
                                        <a href="/pet/view/shop"
                                            class="btn btn-danger rounded-pill px-4 py-2 fw-bold shadow">Shop
                                            Collection</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <% } %>

            </div>
        </main>

        <style>
            /* Premium UI Tweaks */
            .pet-card {
                transition: transform 0.2s ease, box-shadow 0.2s ease;
            }

            .pet-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 .5rem 1.5rem rgba(0, 0, 0, .08) !important;
            }

            .border-dashed {
                border: 2px dashed #dee2e6 !important;
            }
        </style>

        <%- include('./partials/footer') %>