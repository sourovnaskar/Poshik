<%- include('./partials/header', { title: 'My Profile' }) %>

<%- include('./partials/navbar') %>

<main class="main-content">
    <div class="container-fluid py-3 py-md-4">
        
        <!-- Header & Breadcrumbs -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
            <div class="w-100 text-truncate">
                <h3 class="fw-bold text-dark mb-1"><i class="fa-solid fa-user-gear me-2 text-primary"></i>My Profile</h3>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0 flex-nowrap overflow-hidden">
                        <li class="breadcrumb-item"><a href="/api/pet/dashboard" class="text-decoration-none text-truncate">Dashboard</a></li>
                        <li class="breadcrumb-item active text-truncate" aria-current="page">Profile Details</li>
                    </ol>
                </nav>
            </div>
        </div>

        <!-- Flash Messages -->
        <% if (locals.messages && messages.error) { %>
            <div class="alert alert-danger alert-dismissible fade show shadow-sm text-break" role="alert">
                <i class="fa-solid fa-circle-exclamation me-2"></i><%= messages.error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>
        <% if (locals.messages && messages.success) { %>
            <div class="alert alert-success alert-dismissible fade show shadow-sm text-break" role="alert">
                <i class="fa-solid fa-circle-check me-2"></i><%= messages.success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <div class="row g-3 g-md-4">
            
            <!-- Left Column: Profile Card -->
            <div class="col-12 col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 text-center overflow-hidden h-100">
                    <div class="bg-primary bg-opacity-10 py-4">
                        <img src="<%= user.image || '/images/default-avatar.png' %>" alt="<%= user.name %>" 
                             class="rounded-circle shadow object-fit-cover bg-white p-1" 
                             style="width: 130px; height: 130px; border: 4px solid #fff;">
                    </div>
                    
                    <div class="card-body p-3 p-md-4 pt-3">
                        <h4 class="fw-bold mb-0 text-break"><%= user.name %></h4>
                        <p class="text-muted mb-3 text-break"><%= user.email %></p>
                        
                        <div class="d-flex justify-content-center mb-4">
                            <span class="badge bg-success bg-opacity-10 text-success border border-success px-3 py-2 rounded-pill">
                                <i class="fa-solid fa-check-circle me-1"></i> Active Pet Owner
                            </span>
                        </div>

                        <!-- Change Password Quick Action -->
                        <div class="border-top pt-4">
                            <h6 class="fw-bold text-uppercase small text-muted mb-3">Security</h6>
                            <a href="/owner/change-password" class="btn btn-outline-dark w-100 rounded-pill btn-sm">
                                <i class="fa-solid fa-lock me-2"></i>Change Password
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Update Profile Form -->
            <div class="col-12 col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-header bg-white border-0 pt-3 pt-md-4 pb-0 px-3 px-md-4">
                        <h5 class="fw-bold mb-0">Personal Information</h5>
                    </div>
                    <div class="card-body p-3 p-md-4">
                        
                        <!-- Ensure you create a route matching this action path to handle updates -->
                        <form action="/owner/profile/update" method="POST" enctype="multipart/form-data">
                            
                            <div class="row g-3 mb-4">
                                <!-- Full Name -->
                                <div class="col-12 col-md-6">
                                    <label for="name" class="form-label fw-semibold small mb-1">Full Name</label>
                                    <input type="text" class="form-control bg-light" id="name" name="name" value="<%= user.name %>" required>
                                </div>

                                <!-- Email (Often Read-Only in apps, remove 'readonly' if users can change it) -->
                                <div class="col-12 col-md-6">
                                    <label for="email" class="form-label fw-semibold small mb-1">Email Address</label>
                                    <input type="email" class="form-control bg-light text-muted" id="email" name="email" value="<%= user.email %>" readonly>
                                    <div class="form-text" style="font-size: 0.75rem;">Email cannot be changed.</div>
                                </div>

                                <!-- Phone Number -->
                                <div class="col-12 col-md-6">
                                    <label for="phone" class="form-label fw-semibold small mb-1">Phone Number</label>
                                    <input type="tel" class="form-control bg-light" id="phone" name="phone" value="<%= user.phone || '' %>" placeholder="e.g. +91 9876543210">
                                </div>

                                <!-- Profile Picture Upload -->
                                <div class="col-12 col-md-6">
                                    <label for="image" class="form-label fw-semibold small mb-1">Update Profile Picture</label>
                                    <input type="file" class="form-control bg-light" id="image" name="image" accept="image/png, image/jpeg, image/jpg, image/webp">
                                </div>

                                <!-- Full Address -->
                                <div class="col-12">
                                    <label for="address" class="form-label fw-semibold small mb-1">Shipping / Home Address</label>
                                    <textarea class="form-control bg-light" id="address" name="address" rows="3" placeholder="Enter your full address for product deliveries..."><%= user.address || '' %></textarea>
                                </div>
                            </div>

                            <!-- Submit Button -->
                            <div class="d-flex flex-column flex-md-row justify-content-md-end mt-4">
                                <button type="submit" class="btn btn-primary shadow-sm w-100 w-md-auto">
                                    <i class="fa-solid fa-floppy-disk me-2"></i>Save Changes
                                </button>
                            </div>
                            
                        </form>
                    </div>
                </div>
            </div>

        </div>
    </div>
</main>

<style>
    /* Strict Mobile Utility Overrides */
    @media (max-width: 767.98px) {
        .w-md-auto {
            width: 100% !important;
        }
    }
    @media (min-width: 768px) {
        .w-md-auto {
            width: auto !important;
        }
    }
</style>

<%- include('./partials/footer') %>