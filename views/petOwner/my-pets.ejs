<%- include('./partials/header', { title: 'My Pets' }) %>
    
        <%- include('./partials/navbar') %>

            <main class="main-content">
                <div class="container-fluid py-3 py-md-4">

                    <!-- Header Section (Stacks on 320px) -->
                    <div
                        class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
                        <div class="w-100 text-truncate">
                            <h3 class="fw-bold text-dark mb-1"><i class="fa-solid fa-dog me-2 text-primary"></i>My Pets
                            </h3>
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb mb-0 flex-nowrap overflow-hidden">
                                    <li class="breadcrumb-item"><a href="/pet/dashboard"
                                            class="text-decoration-none text-truncate">Dashboard</a></li>
                                    <li class="breadcrumb-item active text-truncate" aria-current="page">My Pets</li>
                                </ol>
                            </nav>
                        </div>
                        <div class="w-100 w-md-auto">
                            <a href="/pet/add" class="btn btn-primary shadow-sm w-100">
                                <i class="fa-solid fa-plus me-2"></i>Add New Pet
                            </a>
                        </div>
                    </div>

                    <!-- Flash Messages -->
                    <% if (typeof successMsg !=='undefined' && successMsg.length> 0) { %>
                        <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 mb-6 rounded"
                            role="alert">
                            <p>
                                <%= successMsg %>
                            </p>
                        </div>
                        <% } %>

                            <!-- Flash Error Message Block -->
                            <% if (typeof errorMsg !=='undefined' && errorMsg.length> 0) { %>
                                <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 mb-6 rounded"
                                    role="alert">
                                    <p>
                                        <%= errorMsg %>
                                    </p>
                                </div>
                                <% } %>

                                    <% if (pets && pets.length> 0) { %>
                                        <!-- Grid of Pets -->
                                        <div class="row g-3 g-md-4">
                                            <% pets.forEach(pet=> { %>
                                                <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                                                    <div
                                                        class="card h-100 border-0 shadow-sm rounded-4 text-center p-3 transition-hover">

                                                        <!-- Pet Image -->
                                                        <div class="mb-3 mt-2 position-relative d-inline-block">
                                                            <img src="<%= pet.image || '/images/default-pet.png' %>"
                                                                alt="<%= pet.name %>"
                                                                class="rounded-circle object-fit-cover shadow-sm border border-2 border-white"
                                                                style="width: 100px; height: 100px;">
                                                            <!-- Small Gender Indicator Icon -->
                                                            <span
                                                                class="position-absolute bottom-0 end-0 translate-middle p-1 bg-white border border-light rounded-circle shadow-sm"
                                                                style="width: 28px; height: 28px; display: flex; align-items: center; justify-content: center;">
                                                                <% if (pet.gender==='Male' ) { %>
                                                                    <i class="fa-solid fa-mars text-info"
                                                                        style="font-size: 0.8rem;"></i>
                                                                    <% } else if (pet.gender==='Female' ) { %>
                                                                        <i class="fa-solid fa-venus text-danger"
                                                                            style="font-size: 0.8rem;"></i>
                                                                        <% } else { %>
                                                                            <i class="fa-solid fa-paw text-secondary"
                                                                                style="font-size: 0.8rem;"></i>
                                                                            <% } %>
                                                            </span>
                                                        </div>

                                                        <!-- Pet Details -->
                                                        <h5 class="fw-bold mb-1 text-truncate" style="max-width: 100%;">
                                                            <%= pet.name %>
                                                        </h5>
                                                        <p class="text-muted small mb-3 text-truncate"
                                                            style="max-width: 100%;">
                                                            <%= pet.breed ? pet.breed : pet.species %>
                                                                <% if (pet.age) { %> • <%= pet.age %>
                                                                        <% } %> years
                                                        </p>

                                                        <!-- Action Buttons -->
                                                        <div class="mt-auto d-flex flex-column gap-2">
                                                            <a href="/pet/profile/<%= pet._id %>"
                                                                class="btn btn-light border rounded-pill btn-sm fw-medium text-primary">
                                                                <i class="fa-regular fa-eye me-1"></i> View Profile
                                                            </a>
                                                            <a href="/pet/edit/<%= pet._id %>"
                                                                class="btn btn-outline-secondary rounded-pill btn-sm">
                                                                <i class="fa-solid fa-pen me-1"></i> Edit
                                                            </a>
                                                        </div>
                                                    </div>
                                                </div>
                                                <% }) %>
                                        </div>
                                        <!-- Pagination UI -->
                                        <% if (totalPages> 1) { %>
                                            <nav aria-label="Pet pagination" class="mt-4 d-flex justify-content-center">
                                                <ul class="pagination shadow-sm">

                                                    <!-- Previous Button -->
                                                    <li class="page-item <%= !hasPrevPage ? 'disabled' : '' %>">
                                                        <a class="page-link" href="?page=<%= currentPage - 1 %>"
                                                            tabindex="-1">Previous</a>
                                                    </li>

                                                    <!-- Page Numbers -->
                                                    <% for(let i=1; i <=totalPages; i++) { %>
                                                        <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                                                            <a class="page-link" href="?page=<%= i %>">
                                                                <%= i %>
                                                            </a>
                                                        </li>
                                                        <% } %>

                                                            <!-- Next Button -->
                                                            <li class="page-item <%= !hasNextPage ? 'disabled' : '' %>">
                                                                <a class="page-link"
                                                                    href="?page=<%= currentPage + 1 %>">Next</a>
                                                            </li>

                                                </ul>
                                            </nav>
                                            <% } %>
                                                <% } else { %>
                                                    <!-- Empty State for No Pets -->
                                                    <div class="card border-0 shadow-sm rounded-4 mt-3">
                                                        <div class="card-body p-4 p-md-5 text-center">
                                                            <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-4"
                                                                style="width: 100px; height: 100px;">
                                                                <i class="fa-solid fa-paw text-muted fs-1"></i>
                                                            </div>
                                                            <h4 class="fw-bold mb-2">No Pets Found</h4>
                                                            <p class="text-muted mb-4 max-w-500 mx-auto">You haven't
                                                                added any
                                                                pets to your profile yet. Add your furry friends to
                                                                start
                                                                booking vet appointments and shopping for their needs.
                                                            </p>
                                                            <a href="/pet/add"
                                                                class="btn btn-primary px-4 py-2 shadow-sm rounded-pill">
                                                                <i class="fa-solid fa-plus me-2"></i>Add Your First Pet
                                                            </a>
                                                        </div>
                                                    </div>
                                                    <% } %>

                </div>
            </main>

            <style>
                /* Hover effect for cards */
                .transition-hover {
                    transition: transform 0.2s ease, box-shadow 0.2s ease;
                }

                .transition-hover:hover {
                    transform: translateY(-3px);
                    box-shadow: 0 .5rem 1rem rgba(0, 0, 0, .10) !important;
                }

                /* Strict Mobile Utility Overrides */
                @media (max-width: 767.98px) {
                    .w-md-auto {
                        width: 100% !important;
                    }
                }

                @media (min-width: 768px) {
                    .w-md-auto {
                        width: auto !important;
                    }
                }
            </style>

            <%- include('./partials/footer') %>