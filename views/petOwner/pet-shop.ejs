<%- include('./partials/header') %>
 
        <%- include('./partials/navbar') %>

            <style>
                /* Hover effect for shop cards to make them feel interactive */
                .shop-card {
                    transition: transform 0.2s ease, box-shadow 0.2s ease;
                    cursor: pointer;
                }

                .shop-card:hover {
                    transform: translateY(-5px);
                    box-shadow: 0 .5rem 1rem rgba(0, 0, 0, .15) !important;
                }

                .shop-logo-wrapper {
                    width: 80px;
                    height: 80px;
                    border-radius: 50%;
                    border: 4px solid #fff;
                    margin-top: -40px;
                    position: relative;
                    z-index: 2;
                    background: #fff;
                    box-shadow: 0 2px 4px rgba(0, 0, 0, .1);
                }

                .shop-banner {
                    height: 140px;
                    object-fit: cover;
                    border-top-left-radius: 0.5rem;
                    border-top-right-radius: 0.5rem;
                }
            </style>

            <div class="d-flex bg-light min-vh-100">

                <!-- Include User Sidebar -->


                <!-- Main Content Area -->
                <main class="flex-grow-1 px-md-4 py-4" style="width: 0; overflow-x: hidden;">

                    <!-- Hero / Search Section -->
                    <div class="bg-white p-4 rounded-4 shadow-sm mb-4 border-0">
                        <div class="row align-items-center">
                            <div class="col-md-7">
                                <h1 class="h3 fw-bold text-dark mb-2">Find Pet Shops Near You</h1>
                                <p class="text-muted mb-md-0">Discover the best pet food, toys, and accessories from
                                    top-rated local vendors.</p>
                            </div>
                            <div class="col-md-5">
                                <form action="/api/user/shops" method="GET" class="position-relative">
                                    <i
                                        class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                                    <input type="text" name="search"
                                        class="form-control form-control-lg bg-light ps-5 border-0"
                                        placeholder="Search for shops..."
                                        value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- Flash Messages -->
                    <%- include('./partials/flash') %>

                        <!-- Shop Grid -->
                        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">

                            <% if (typeof shops !=='undefined' && shops.length> 0) { %>
                                <% shops.forEach(shop=> { %>
                                    <div class="col">
                                        <!-- Wrap the entire card in an anchor tag for better UX -->
                                        <a href="/api/pet/view/products/<%= shop._id %>" class="text-decoration-none">
                                            <div class="card h-100 border-0 shadow-sm shop-card rounded-3">

                                                <!-- Shop Banner -->
                                                <% if (shop.logo) { %>
                                                    <img src="<%= shop.logo %>" class="card-img-top shop-banner"
                                                        alt="<%= shop.shopName %> Banner">
                                                    <% } else { %>
                                                        <!-- Fallback Banner -->
                                                        <div
                                                            class="card-img-top shop-banner bg-secondary-subtle d-flex justify-content-center align-items-center">
                                                            <i
                                                                class="bi bi-shop text-secondary opacity-50 display-1"></i>
                                                        </div>
                                                        <% } %>

                                                            <div class="card-body text-center position-relative pt-0">
                                                                <!-- Shop Logo -->
                                                                <div class="shop-logo-wrapper mx-auto mb-3">
                                                                    <img src="<%= shop.logo || 'https://ui-avatars.com/api/?name=' + shop.shopName + '&background=0D8ABC&color=fff' %>"
                                                                        alt="<%= shop.shopName %> Logo"
                                                                        class="rounded-circle w-100 h-100 object-fit-cover">
                                                                </div>

                                                                <!-- Shop Details -->
                                                                <h5
                                                                    class="card-title fw-bold text-dark mb-1 text-truncate">
                                                                    <%= shop.shopName %>
                                                                </h5>

                                                                <div
                                                                    class="d-flex justify-content-center align-items-center gap-2 mb-3">
                                                                    <span
                                                                        class="badge bg-success-subtle text-success"><i
                                                                            class="bi bi-star-fill me-1"></i> 4.5</span>
                                                                    <small class="text-muted">•</small>
                                                                    <small class="text-muted"><i
                                                                            class="bi bi-geo-alt me-1"></i> Local
                                                                        Area</small>
                                                                </div>

                                                                <p class="card-text text-muted small text-truncate"
                                                                    style="max-width: 250px; margin: 0 auto;">
                                                                    <%= shop.description
                                                                        || 'Premium pet supplies and accessories.' %>
                                                                </p>
                                                            </div>

                                                            <div
                                                                class="card-footer bg-white border-top-0 pb-4 pt-0 text-center">
                                                                <span
                                                                    class="btn btn-outline-primary fw-bold px-4 rounded-pill">
                                                                    Visit Shop
                                                                </span>
                                                            </div>
                                            </div>
                                        </a>
                                    </div>
                                    <% }) %>
                                        <% } else { %>
                                            <!-- Empty State -->
                                            <div class="col-12 text-center py-5">
                                                <i
                                                    class="bi bi-shop-window display-1 text-muted opacity-25 d-block mb-3"></i>
                                                <h4 class="fw-bold text-dark">No Shops Found</h4>
                                                <p class="text-muted">We couldn't find any active pet shops at the
                                                    moment. Please check back later!</p>
                                                <% if (typeof searchQuery !=='undefined' && searchQuery) { %>
                                                    <a href="/api/user/shops" class="btn btn-primary mt-2">Clear
                                                        Search</a>
                                                    <% } %>
                                            </div>
                                            <% } %>
                        </div>

                        <!-- Pagination -->
                        <% if (typeof totalPages !=='undefined' && totalPages> 1) { %>
                            <div class="d-flex justify-content-center mt-5">
                                <nav aria-label="Shop pagination">
                                    <ul class="pagination shadow-sm">
                                        <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                                            <a class="page-link text-dark"
                                                href="?page=<%= currentPage - 1 %>">Previous</a>
                                        </li>
                                        <% for (let i=1; i <=totalPages; i++) { %>
                                            <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                                                <a class="page-link <%= currentPage === i ? 'bg-primary border-primary' : 'text-dark' %>"
                                                    href="?page=<%= i %>">
                                                    <%= i %>
                                                </a>
                                            </li>
                                            <% } %>
                                                <li
                                                    class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                                                    <a class="page-link text-dark"
                                                        href="?page=<%= currentPage + 1 %>">Next</a>
                                                </li>
                                    </ul>
                                </nav>
                            </div>
                            <% } %>

                </main>
            </div>

            <%- include('./partials/footer') %>