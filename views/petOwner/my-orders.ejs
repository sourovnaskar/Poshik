<%- include('./partials/header') %>
    <%- include('./partials/navbar') %>

    <style>
        .order-card {
            border: none;
            border-radius: 1rem;
            box-shadow: 0 2px 12px rgba(0,0,0,0.06);
            transition: box-shadow 0.2s, transform 0.2s;
        }
        .order-card:hover {
            box-shadow: 0 6px 24px rgba(0,0,0,0.1);
            transform: translateY(-2px);
        }
        .status-pill {
            font-size: 0.75rem;
            font-weight: 600;
            padding: 0.3em 0.8em;
            border-radius: 50rem;
        }
    </style>

    <div class="d-flex bg-light min-vh-100">
        <main class="flex-grow-1 px-md-4 py-4 mb-5" style="width:0; overflow-x:hidden;">

            <h1 class="h3 fw-bold text-dark mb-1">My Orders</h1>
            <p class="text-muted small mb-4"><%= totalOrders %> order<%= totalOrders !== 1 ? 's' : '' %> found</p>

            <%- include('./partials/flash') %>

            <% if (!orders || orders.length === 0) { %>
                <!-- Empty State -->
                <div class="bg-white rounded-4 shadow-sm text-center py-5">
                    <i class="bi bi-box-seam display-1 text-muted opacity-25 d-block mb-3"></i>
                    <h4 class="fw-bold text-dark">No orders yet</h4>
                    <p class="text-muted mb-4">Browse our pet shops and place your first order!</p>
                    <a href="/pet/view/shop" class="btn btn-primary fw-bold px-4 rounded-pill">
                        Shop Now
                    </a>
                </div>
            <% } else { %>
                <div class="d-flex flex-column gap-3">
                    <% orders.forEach(order => { %>
                        <div class="bg-white order-card p-4">
                            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">

                                <!-- Left: Order Info -->
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="fw-bold text-dark">#<%= order.orderNumber %></span>
                                        <!-- Status Badge -->
                                        <span class="status-pill
                                            <% if (order.orderStatus === 'Pending') { %>bg-warning-subtle text-warning border border-warning-subtle
                                            <% } else if (order.orderStatus === 'Confirmed') { %>bg-info-subtle text-info border border-info-subtle
                                            <% } else if (order.orderStatus === 'Processing') { %>bg-primary-subtle text-primary border border-primary-subtle
                                            <% } else if (order.orderStatus === 'Shipped') { %>bg-secondary-subtle text-secondary border border-secondary-subtle
                                            <% } else if (order.orderStatus === 'Delivered') { %>bg-success-subtle text-success border border-success-subtle
                                            <% } else { %>bg-danger-subtle text-danger border border-danger-subtle
                                            <% } %>">
                                            <%= order.orderStatus %>
                                        </span>
                                    </div>
                                    <div class="text-muted small mb-1">
                                        <i class="bi bi-shop me-1"></i><%= order.shop ? order.shop.shopName : 'Shop' %>
                                    </div>
                                    <div class="text-muted small">
                                        <i class="bi bi-calendar3 me-1"></i>
                                        <%= new Date(order.createdAt).toLocaleDateString('en-IN', {day:'numeric', month:'short', year:'numeric'}) %>
                                    </div>
                                </div>

                                <!-- Right: Total + Action -->
                                <div class="text-end">
                                    <div class="fw-bold fs-5 text-success mb-1">₹<%= order.totalAmount %></div>
                                    <div class="text-muted small mb-2">
                                        <%= order.items.length %> item<%= order.items.length !== 1 ? 's' : '' %>
                                        &nbsp;·&nbsp; <%= order.paymentMethod %>
                                    </div>
                                    <a href="/pet/view/shop" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                        View Details
                                    </a>
                                </div>

                            </div>

                            <!-- Item Names Preview -->
                            <div class="mt-3 pt-3 border-top text-muted small">
                                <% order.items.slice(0, 3).forEach((item, idx) => { %>
                                    <% if (idx > 0) { %><span class="mx-1 text-muted">·</span><% } %>
                                    <%= item.productName %>
                                <% }) %>
                                <% if (order.items.length > 3) { %>
                                    <span class="ms-1 text-muted">+ <%= order.items.length - 3 %> more</span>
                                <% } %>
                            </div>
                        </div>
                    <% }) %>
                </div>

                <!-- Pagination -->
                <% if (totalPages > 1) { %>
                    <nav class="mt-4 d-flex justify-content-center">
                        <ul class="pagination">
                            <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                                <a class="page-link rounded-start-pill" href="?page=<%= currentPage - 1 %>">‹</a>
                            </li>
                            <% for (let i = 1; i <= totalPages; i++) { %>
                                <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                                    <a class="page-link" href="?page=<%= i %>"><%= i %></a>
                                </li>
                            <% } %>
                            <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                                <a class="page-link rounded-end-pill" href="?page=<%= currentPage + 1 %>">›</a>
                            </li>
                        </ul>
                    </nav>
                <% } %>
            <% } %>

        </main>
    </div>

<%- include('./partials/footer') %>
