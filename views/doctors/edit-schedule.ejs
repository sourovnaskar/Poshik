<%- include('partials/header') %>
    <%- include('partials/sidebar') %>

        <div class="md:ml-64 flex flex-col min-h-screen bg-gray-50">

            <!-- Top Navbar & Flash Messages -->
            <%- include('partials/navbar') %>
                <%- include('partials/flash') %>

                    <main class="flex-1 p-4 sm:p-6 lg:p-8 w-full max-w-3xl mx-auto overflow-x-hidden">

                        <!-- Header Section -->
                        <div class="mb-6 flex items-center justify-between">
                            <div>
                                <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Edit Shift</h1>
                                <p class="text-xs sm:text-sm text-gray-600 mt-1">Update the timings or token limit for
                                    this shift.</p>
                            </div>
                            <a href="/api/doctor/appointment/schedule"
                                class="text-sm font-medium text-gray-500 hover:text-gray-700 bg-white border border-gray-300 px-4 py-2 rounded-md shadow-sm transition">
                                ← Back to Schedule
                            </a>
                        </div>

                        <!-- UPDATE SHIFT FORM -->
                        <div class="bg-white p-4 sm:p-6 rounded-lg shadow-sm border border-gray-100 mb-8">

                            <!-- Date Formatting Logic for HTML Input -->
                            <!-- HTML date inputs require exactly "YYYY-MM-DD" format -->
                            <% const formattedDate=new Date(schedule.date).toISOString().split('T')[0]; %>

                                <!-- Notice the action points to an update route with the schedule's ID -->
                                <form action="/api/doctor/appointment/update/schedule/<%= schedule._id %>" method="POST"
                                    class="space-y-6">

                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">

                                        <!-- Date -->
                                        <div>
                                            <label for="date" class="block text-sm font-medium text-gray-700 mb-1">Date
                                                *</label>
                                            <input type="date" name="date" id="date" value="<%= formattedDate %>"
                                                required
                                                class="w-full border border-gray-300 rounded-md shadow-sm p-2.5 text-sm focus:ring-teal-500 focus:border-teal-500 bg-white">
                                        </div>

                                        <!-- Max Patients (Tokens) -->
                                        <div>
                                            <label for="maxPatients"
                                                class="block text-sm font-medium text-gray-700 mb-1">Max Patients
                                                (Tokens) *</label>
                                            <input type="number" name="maxPatients" id="maxPatients" min="1"
                                                value="<%= schedule.maxPatients %>" required
                                                class="w-full border border-gray-300 rounded-md shadow-sm p-2.5 text-sm focus:ring-teal-500 focus:border-teal-500 bg-white">

                                            <% if (schedule.bookedCount> 0) { %>
                                                <p class="text-xs text-orange-600 mt-1 font-medium">
                                                    ⚠️ <%= schedule.bookedCount %> patients have already booked. You
                                                        cannot set the max below this number.
                                                </p>
                                                <% } %>
                                        </div>

                                        <!-- Start Time -->
                                        <div>
                                            <label for="startTime"
                                                class="block text-sm font-medium text-gray-700 mb-1">Start Time
                                                *</label>
                                            <input type="time" name="startTime" id="startTime"
                                                value="<%= schedule.startTime %>" required
                                                class="w-full border border-gray-300 rounded-md shadow-sm p-2.5 text-sm focus:ring-teal-500 focus:border-teal-500 bg-white">
                                        </div>

                                        <!-- End Time -->
                                        <div>
                                            <label for="endTime"
                                                class="block text-sm font-medium text-gray-700 mb-1">End Time *</label>
                                            <input type="time" name="endTime" id="endTime"
                                                value="<%= schedule.endTime %>" required
                                                class="w-full border border-gray-300 rounded-md shadow-sm p-2.5 text-sm focus:ring-teal-500 focus:border-teal-500 bg-white">
                                        </div>

                                    </div>

                                    <div
                                        class="pt-4 border-t border-gray-100 flex flex-col sm:flex-row justify-end gap-3">
                                        <a href="/api/doctor/appointment/schedule"
                                            class="w-full sm:w-auto bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold py-2.5 px-6 rounded-md shadow-sm transition text-sm text-center">
                                            Cancel
                                        </a>
                                        
                                        <button type="submit"
                                            class="w-full sm:w-auto bg-teal-600 hover:bg-teal-700 text-white font-bold py-2.5 px-6 rounded-md shadow-sm transition text-sm flex justify-center items-center gap-2">
                                            Update Shift
                                        </button>
                                    </div>
                                </form>
                        </div>

                    </main>
        </div>

        <!-- Ensure they cannot pick a past date -->
        <script>
            const dateInput = document.getElementById('date');
            if (dateInput) {
                const today = new Date().toISOString().split('T')[0];
                dateInput.setAttribute('min', today);

                // Client-side validation: Prevent maxPatients from being lower than currently booked
                const maxPatientsInput = document.getElementById('maxPatients');
                const bookedCount = parseInt("<%= schedule.bookedCount || 0 %>", 10);

                if (bookedCount > 0) {
                    maxPatientsInput.setAttribute('min', bookedCount);
                }
            }
        </script>

        <%- include('partials/footer') %>