<%- include('partials/header') %>
  <%- include('partials/sidebar') %>

    <!-- Main Wrapper with Left Margin (md:ml-64) to offset the fixed sidebar -->
    <div class="md:ml-64 flex flex-col min-h-screen bg-gray-50">

      <!-- Top Navbar -->
      <%- include('partials/navbar') %>
      <%- include('partials/flash') %>

        <!-- Main KYC Form Content -->
        <main class="flex-1 p-4 sm:p-6 lg:p-8 w-full max-w-3xl mx-auto">

          <div class="mb-6 text-center sm:text-left">
            <h1 class="text-xl sm:text-2xl font-bold text-gray-800">Complete Your KYC</h1>
            <p class="text-xs sm:text-sm text-gray-600 mt-1 sm:mt-2">Upload clear, legible photos of your documents to
              verify your medical credentials.</p>
          </div>

          

             

                  <form action="/doctor/kyc/submit" method="POST" enctype="multipart/form-data"
                    class="bg-white p-4 sm:p-6 rounded-lg shadow-sm border border-gray-100 space-y-6 sm:space-y-8">

                    <!-- 1. Identity Verification Section -->
                    <div class="space-y-4">
                      <h2 class="text-base sm:text-lg font-semibold text-teal-700 border-b pb-2">1. Identity
                        Verification</h2>

                      <div>
                        <label for="idType" class="block text-sm font-medium text-gray-700 mb-1">Select ID Type
                          *</label>
                        <select name="idType" id="idType" required
                          class="w-full border border-gray-300 rounded-md shadow-sm p-2.5 text-sm focus:ring-teal-500 focus:border-teal-500 bg-white">
                          <option value="" disabled selected>Select an option...</option>
                          <option value="Aadhaar">Aadhaar Card</option>
                          <option value="Pan">PAN Card</option>
                          <option value="Voter">Voter ID</option>
                        </select>
                      </div>

                      <div>
                        <label for="idProof" class="block text-sm font-medium text-gray-700 mb-1">Upload ID Proof
                          (Image) *</label>
                        <!-- Using block and w-full ensures it doesn't overflow on 320px -->
                        <input type="file" name="idProof" id="idProof" accept="image/*" required
                          class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-3 sm:file:px-4 file:rounded-md file:border-0 file:text-xs sm:file:text-sm file:font-semibold file:bg-teal-50 file:text-teal-700 hover:file:bg-teal-100 cursor-pointer border border-gray-200 rounded-md">
                      </div>
                    </div>

                    <!-- 2. Address Verification Section -->
                    <div class="space-y-4 pt-2">
                      <h2 class="text-base sm:text-lg font-semibold text-teal-700 border-b pb-2">2. Address Verification
                      </h2>

                      <div>
                        <label for="addressProofType" class="block text-sm font-medium text-gray-700 mb-1">Select
                          Address Proof Type *</label>
                        <select name="addressProofType" id="addressProofType" required
                          class="w-full border border-gray-300 rounded-md shadow-sm p-2.5 text-sm focus:ring-teal-500 focus:border-teal-500 bg-white">
                          <option value="" disabled selected>Select an option...</option>
                          <option value="Aadhaar">Aadhaar Card</option>
                          <option value="Voter">Voter ID</option>
                          <option value="Pan">PAN Card</option>
                        </select>
                      </div>

                      <div>
                        <label for="addressProof" class="block text-sm font-medium text-gray-700 mb-1">Upload Address
                          Proof (Image) *</label>
                        <input type="file" name="addressProof" id="addressProof" accept="image/*" required
                          class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-3 sm:file:px-4 file:rounded-md file:border-0 file:text-xs sm:file:text-sm file:font-semibold file:bg-teal-50 file:text-teal-700 hover:file:bg-teal-100 cursor-pointer border border-gray-200 rounded-md">
                      </div>
                    </div>

                    <!-- 3. Professional Credentials Section -->
                    <div class="space-y-4 pt-2">
                      <h2 class="text-base sm:text-lg font-semibold text-teal-700 border-b pb-2">3. Professional
                        Credentials</h2>

                      <div>
                        <label for="license" class="block text-sm font-medium text-gray-700 mb-1">Medical License
                          (Optional but recommended)</label>
                        <input type="file" name="license" id="license" accept="image/*"
                          class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-3 sm:file:px-4 file:rounded-md file:border-0 file:text-xs sm:file:text-sm file:font-semibold file:bg-teal-50 file:text-teal-700 hover:file:bg-teal-100 cursor-pointer border border-gray-200 rounded-md">
                      </div>

                      <div>
                        <label for="certificate" class="block text-sm font-medium text-gray-700 mb-1">Degree Certificate
                          (Optional)</label>
                        <input type="file" name="certificate" id="certificate" accept="image/*"
                          class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-3 sm:file:px-4 file:rounded-md file:border-0 file:text-xs sm:file:text-sm file:font-semibold file:bg-teal-50 file:text-teal-700 hover:file:bg-teal-100 cursor-pointer border border-gray-200 rounded-md">
                      </div>
                    </div>

                    <!-- Submit Button -->
                    <div class="pt-4 pb-2">
                      <button type="submit"
                        class="w-full bg-teal-600 hover:bg-teal-700 text-white font-bold py-3 px-4 rounded-md shadow-sm transition text-sm sm:text-base flex justify-center items-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path>
                        </svg>
                        Submit Documents
                      </button>
                    </div>

                  </form>
        </main>

    </div>

    <%- include('partials/footer') %>