<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<!-- Main Wrapper with Left Margin (md:ml-64) to offset the fixed sidebar -->
<div class="md:ml-64 flex flex-col min-h-screen bg-gray-50">
  
  <!-- Top Navbar -->
  <%- include('partials/navbar') %>
  <%- include('partials/flash') %>
  
  <!-- Main Dashboard Content -->
  <main class="flex-1 p-4 md:p-6 lg:p-8 w-full overflow-x-hidden">
    
    <!-- DYNAMIC KYC & PROFILE BANNERS -->
    <% if (user.kycStatus === 'Not Submitted') { %>
      <div class="bg-red-50 border-l-4 border-red-500 p-5 mb-6 rounded-lg shadow-sm">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
          <div>
            <h3 class="text-red-800 font-bold text-lg">⚠️ Action Required: Account Restricted</h3>
            <p class="text-red-600 text-sm mt-1 font-medium">Complete your KYC to list your clinic and start receiving appointments.</p>
          </div>
          <a href="/doctor/kyc/form" class="w-full sm:w-auto bg-red-600 hover:bg-red-700 text-white font-bold py-2.5 px-6 rounded-full text-center text-sm transition whitespace-nowrap shadow-sm">
            Complete KYC Now
          </a>
        </div>
      </div>
    <% } else if (user.kycStatus === 'Pending') { %>
      <div class="bg-yellow-50 border-l-4 border-yellow-500 p-5 mb-6 rounded-lg shadow-sm flex items-start sm:items-center gap-4">
        <div class="text-yellow-500 text-2xl animate-spin hidden sm:block"><i class="fa-solid fa-spinner"></i></div>
        <div>
          <h3 class="text-yellow-800 font-bold text-lg flex items-center gap-2">
            <span class="sm:hidden text-yellow-500 animate-spin"><i class="fa-solid fa-spinner"></i></span>
            Documents Under Review
          </h3>
          <p class="text-yellow-700 text-sm mt-1 font-medium">We are verifying your KYC documents. This usually takes 24-48 hours. You will be notified once approved.</p>
        </div>
      </div>
    <% } else if (user.kycStatus === 'Rejected') { %>
      <div class="bg-red-100 border-l-4 border-red-600 p-5 mb-6 rounded-lg shadow-sm">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
          <div>
            <h3 class="text-red-800 font-bold text-lg">❌ KYC Rejected</h3>
            <p class="text-red-700 text-sm mt-1 font-medium">Reason: <%= typeof rejectionReason !== 'undefined' ? rejectionReason : 'Invalid documents provided.' %></p>
          </div>
          <a href="/doctor/kyc/form" class="w-full sm:w-auto bg-red-600 hover:bg-red-700 text-white font-bold py-2.5 px-6 rounded-full text-center text-sm transition whitespace-nowrap shadow-sm">
            Resubmit Documents
          </a>
        </div>
      </div>
    <% } else if (user.kycStatus === 'Approved' && !hasProfile) { %>
      <!-- KYC is Approved, but Doctor Profile is missing -->
      <div class="bg-blue-50 border-l-4 border-blue-500 p-5 mb-6 rounded-lg shadow-sm">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
          <div>
            <h3 class="text-blue-800 font-bold text-lg">🎉 KYC Approved! Final Step</h3>
            <p class="text-blue-600 text-sm mt-1 font-medium">Set up your medical profile, consultation fees, and clinic details to start accepting patients.</p>
          </div>
          <a href="/doctor/profile/form" class="w-full sm:w-auto bg-blue-600 hover:bg-blue-700 text-white font-bold py-2.5 px-6 rounded-full text-center text-sm transition whitespace-nowrap shadow-sm">
            Create Profile Now
          </a>
        </div>
      </div>
    <% } %>

    <!-- Determine if the dashboard should be locked -->
    <% const isLocked = user.kycStatus !== 'Approved' || !hasProfile; %>

    <!-- DASHBOARD WIDGETS (Blurred if locked) -->
    <div class="<%= isLocked ? 'opacity-40 pointer-events-none relative transition-all duration-300 select-none' : '' %>">
      
      <% if (isLocked) { %>
        <!-- Overlay Lock Icon for Restricted View -->
        <div class="absolute inset-0 flex flex-col items-center justify-center z-10 pointer-events-auto">
          <div class="bg-white/95 p-8 rounded-3xl shadow-2xl text-center max-w-sm border border-gray-100 backdrop-blur-md transform hover:scale-105 transition-transform duration-300">
            <div class="w-20 h-20 bg-gray-50 rounded-full flex items-center justify-center mx-auto mb-5 shadow-inner">
              <i class="fa-solid fa-lock text-3xl text-gray-400"></i>
            </div>
            <h2 class="text-xl font-extrabold text-gray-800 mb-2">Dashboard Locked</h2>
            <p class="text-gray-500 text-sm mb-6 font-medium leading-relaxed">Complete your verification and profile setup to unlock full access to your practice tools and appointments.</p>
            <% if (user.kycStatus === 'Not Submitted') { %>
                <a href="/doctor/kyc/form" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2.5 rounded-full font-bold shadow-lg shadow-blue-200 transition-colors w-full block">Verify Account</a>
            <% } else if (user.kycStatus === 'Approved' && !hasProfile) { %>
                <a href="/doctor/profile/form" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2.5 rounded-full font-bold shadow-lg shadow-blue-200 transition-colors w-full block">Setup Profile</a>
            <% } else { %>
                <button disabled class="bg-gray-300 text-gray-500 px-6 py-2.5 rounded-full font-bold w-full cursor-not-allowed">Pending Verification</button>
            <% } %>
          </div>
        </div>
      <% } %>

      <!-- Premium Welcome Section -->
      <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 mb-8 flex flex-col md:flex-row items-center justify-between gap-6 relative overflow-hidden">
        <!-- Decorative background shape -->
        <div class="absolute right-0 top-0 w-64 h-64 bg-teal-50 rounded-full -translate-y-32 translate-x-32 blur-3xl opacity-60 pointer-events-none"></div>
        
        <div class="relative z-10 flex flex-col md:flex-row items-center md:items-start gap-5">
          <div class="w-16 h-16 bg-gradient-to-br from-teal-100 to-emerald-100 text-teal-600 rounded-full flex items-center justify-center text-2xl shadow-inner shrink-0 border border-teal-200">
            <i class="fa-solid fa-user-doctor"></i>
          </div>
          <div class="text-center md:text-left pt-1">
            <h1 class="text-2xl font-extrabold text-gray-900 tracking-tight">Welcome back, Dr. <%= typeof user !== 'undefined' && user ? user.name.split(' ')[0] : 'Doctor' %></h1>
            <p class="text-gray-500 mt-1 font-medium">Here is what's happening at your clinic today.</p>
          </div>
        </div>

        <% if (user.kycStatus === 'Approved' && hasProfile) { %>
          <div class="relative z-10 bg-green-50 border border-green-200 text-green-700 px-4 py-2 rounded-full flex items-center gap-2 font-bold shadow-sm">
            <span class="relative flex h-3 w-3">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-3 w-3 bg-green-500"></span>
            </span>
            Verified Practice
          </div>
        <% } %>
      </div>
      
      <!-- Stats Grid (Modernized) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
        
        <!-- Stat Card 1 -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md hover:border-blue-200 transition-all duration-300 group relative overflow-hidden">
          <div class="absolute right-0 top-0 w-24 h-24 bg-blue-50 rounded-bl-[100px] -z-10 group-hover:scale-125 transition-transform duration-500"></div>
          <div class="flex justify-between items-start">
            <div>
              <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-1">Today's Visits</p>
              <h3 class="text-3xl font-extrabold text-gray-900"><%= typeof todaysAppointmentsCount !== 'undefined' ? todaysAppointmentsCount : 0 %></h3>
            </div>
            <div class="p-3 bg-blue-100 text-blue-600 rounded-xl shadow-inner">
              <i class="fa-solid fa-calendar-day text-xl"></i>
            </div>
          </div>
          <div class="mt-5 flex items-center text-sm">
            <span class="text-blue-600 font-bold">View schedule</span>
            <i class="fa-solid fa-arrow-right ml-1 text-xs opacity-0 group-hover:opacity-100 transition-all transform group-hover:translate-x-1"></i>
          </div>
          <a href="/doctor/appointment/schedule" class="absolute inset-0 z-20"></a>
        </div>

        <!-- Stat Card 2 -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md hover:border-yellow-200 transition-all duration-300 group relative overflow-hidden">
          <div class="absolute right-0 top-0 w-24 h-24 bg-yellow-50 rounded-bl-[100px] -z-10 group-hover:scale-125 transition-transform duration-500"></div>
          <div class="flex justify-between items-start">
            <div>
              <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-1">Pending Requests</p>
              <h3 class="text-3xl font-extrabold text-gray-900"><%= typeof pendingAppointmentsCount !== 'undefined' ? pendingAppointmentsCount : 0 %></h3>
            </div>
            <div class="p-3 bg-yellow-100 text-yellow-600 rounded-xl shadow-inner">
              <i class="fa-solid fa-hourglass-half text-xl"></i>
            </div>
          </div>
          <div class="mt-5 flex items-center text-sm">
            <span class="text-yellow-600 font-bold">Review requests</span>
            <i class="fa-solid fa-arrow-right ml-1 text-xs opacity-0 group-hover:opacity-100 transition-all transform group-hover:translate-x-1"></i>
          </div>
          <a href="/doctor/appointments" class="absolute inset-0 z-20"></a>
        </div>

        <!-- Stat Card 3 -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md hover:border-green-200 transition-all duration-300 sm:col-span-2 lg:col-span-1 relative overflow-hidden">
          <div class="absolute right-0 top-0 w-24 h-24 bg-green-50 rounded-bl-[100px] -z-10"></div>
          <div class="flex justify-between items-start">
            <div>
              <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-1">Weekly Earnings</p>
              <h3 class="text-3xl font-extrabold text-gray-900">₹<%= typeof weeklyEarnings !== 'undefined' ? weeklyEarnings.toLocaleString('en-IN') : '0' %></h3>
            </div>
            <div class="p-3 bg-green-100 text-green-600 rounded-xl shadow-inner">
              <i class="fa-solid fa-indian-rupee-sign text-xl pl-1"></i>
            </div>
          </div>
          <div class="mt-5 text-sm font-medium text-gray-500">
            Based on completed consultations
          </div>
        </div>

      </div>

      <!-- Recent Appointments Section -->
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-gray-50/50">
          <h2 class="text-lg font-extrabold text-gray-900">Upcoming Appointments</h2>
          <a href="/doctor/appointments" class="text-sm font-bold text-teal-600 hover:text-teal-700 bg-teal-50 hover:bg-teal-100 px-4 py-1.5 rounded-full transition-colors shadow-sm">View All</a>
        </div>
        
        <div class="p-0">
          <% if (typeof recentAppointments !== 'undefined' && recentAppointments && recentAppointments.length > 0) { %>
            <div class="overflow-x-auto">
              <table class="w-full text-left border-collapse">
                <thead>
                  <tr class="bg-gray-50/80 text-gray-500 text-xs font-bold uppercase tracking-wider border-b border-gray-100">
                    <th class="px-6 py-4">Patient</th>
                    <th class="px-6 py-4">Schedule</th>
                    <th class="px-6 py-4">Status</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                  <% recentAppointments.forEach(appt => { %>
                    <tr class="hover:bg-gray-50/80 transition-colors group">
                      <td class="px-6 py-4">
                        <div class="flex items-center gap-4">
                          <div class="w-10 h-10 rounded-full bg-teal-50 border border-teal-100 text-teal-600 flex items-center justify-center font-bold shadow-sm">
                            <i class="fa-solid fa-paw"></i>
                          </div>
                          <div>
                            <p class="font-extrabold text-gray-900 flex items-center"><%= appt.pet.name %> <span class="text-[10px] font-bold text-gray-500 border border-gray-200 px-1.5 py-0.5 rounded ml-2 uppercase bg-white shadow-sm"><%= appt.pet.species %></span></p>
                            <p class="text-xs font-medium text-gray-500 mt-0.5">Owner: <%= appt.owner.name %></p>
                          </div>
                        </div>
                      </td>
                      <td class="px-6 py-4">
                        <p class="font-bold text-gray-900"><%= new Date(appt.schedule.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></p>
                        <p class="text-xs font-medium text-gray-500 mt-0.5"><i class="fa-regular fa-clock mr-1 text-gray-400"></i> <%= appt.schedule.startTime %></p>
                      </td>
                      <td class="px-6 py-4">
                        <% 
                          let statusClass = "bg-gray-100 text-gray-700 border-gray-200";
                          if (appt.status === 'Confirmed') statusClass = "bg-blue-50 text-blue-700 border-blue-200";
                          if (appt.status === 'Completed') statusClass = "bg-green-50 text-green-700 border-green-200";
                          if (appt.status === 'Pending') statusClass = "bg-yellow-50 text-yellow-700 border-yellow-200";
                          if (appt.status === 'Cancelled' || appt.status === 'Rejected') statusClass = "bg-red-50 text-red-700 border-red-200";
                        %>
                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold border <%= statusClass %>">
                          <% if(appt.status === 'Confirmed') { %><span class="w-1.5 h-1.5 rounded-full bg-blue-500 mr-1.5"></span><% } %>
                          <% if(appt.status === 'Pending') { %><span class="w-1.5 h-1.5 rounded-full bg-yellow-500 mr-1.5 animate-pulse"></span><% } %>
                          <% if(appt.status === 'Completed') { %><span class="w-1.5 h-1.5 rounded-full bg-green-500 mr-1.5"></span><% } %>
                          <%= appt.status %>
                        </span>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="py-16 px-6 text-center">
              <div class="w-20 h-20 bg-gray-50 rounded-full flex items-center justify-center mx-auto mb-5 border border-gray-100 shadow-inner">
                <i class="fa-regular fa-calendar-xmark text-3xl text-gray-400"></i>
              </div>
              <h3 class="text-lg font-extrabold text-gray-900 mb-1">No upcoming appointments</h3>
              <p class="text-gray-500 text-sm max-w-sm mx-auto mb-6 font-medium leading-relaxed">Your schedule is clear. Patient bookings will appear here once your profile is verified and active.</p>
              <a href="/doctor/appointment/schedule" class="inline-flex items-center text-sm font-bold text-teal-600 hover:text-teal-700 bg-teal-50 hover:bg-teal-100 px-5 py-2.5 rounded-full transition-colors shadow-sm">
                Manage your schedule <i class="fa-solid fa-arrow-right ml-2 text-xs"></i>
              </a>
            </div>
          <% } %>
        </div>
      </div>

    </div>
  </main>
</div>

<%- include('partials/footer') %>