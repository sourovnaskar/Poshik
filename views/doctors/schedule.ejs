<%- include('partials/header') %>
    <%- include('partials/sidebar') %>

        <div class="md:ml-64 flex flex-col min-h-screen bg-gray-50">

            <!-- Top Navbar & Flash Messages -->
            <%- include('partials/navbar') %>
                <%- include('partials/flash') %>

                    <main class="flex-1 p-4 sm:p-6 lg:p-8 w-full max-w-5xl mx-auto overflow-x-hidden">

                        <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                            <div>
                                <h1 class="text-xl sm:text-2xl font-bold text-gray-800">My Schedule & Availability</h1>
                                <p class="text-xs sm:text-sm text-gray-600 mt-1">Create shifts and set the maximum
                                    number of patients you can see per shift.</p>
                            </div>
                        </div>

                        <!-- 1. CREATE NEW SHIFT FORM -->
                        <div class="bg-white p-4 sm:p-6 rounded-lg shadow-sm border border-gray-100 mb-8">
                            <h2 class="text-lg font-semibold text-teal-700 border-b pb-2 mb-4">Add New Shift</h2>

                            <form action="/api/doctor/appointment/create/schedule" method="POST"
                                class="space-y-4 sm:space-y-6">

                                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">

                                    <!-- Date -->
                                    <div>
                                        <label for="date" class="block text-sm font-medium text-gray-700 mb-1">Date
                                            *</label>
                                        <!-- Using min attribute via JS to prevent selecting past dates (optional but good practice) -->
                                        <input type="date" name="date" id="date" required
                                            class="w-full border border-gray-300 rounded-md shadow-sm p-2.5 text-sm focus:ring-teal-500 focus:border-teal-500 bg-white">
                                    </div>

                                    <!-- Start Time -->
                                    <div>
                                        <label for="startTime"
                                            class="block text-sm font-medium text-gray-700 mb-1">Start Time *</label>
                                        <input type="time" name="startTime" id="startTime" required
                                            class="w-full border border-gray-300 rounded-md shadow-sm p-2.5 text-sm focus:ring-teal-500 focus:border-teal-500 bg-white">
                                    </div>

                                    <!-- End Time -->
                                    <div>
                                        <label for="endTime" class="block text-sm font-medium text-gray-700 mb-1">End
                                            Time *</label>
                                        <input type="time" name="endTime" id="endTime" required
                                            class="w-full border border-gray-300 rounded-md shadow-sm p-2.5 text-sm focus:ring-teal-500 focus:border-teal-500 bg-white">
                                    </div>

                                    <!-- Max Patients (Tokens) -->
                                    <div>
                                        <label for="maxPatients"
                                            class="block text-sm font-medium text-gray-700 mb-1">Max Patients (Tokens)
                                            *</label>
                                        <input type="number" name="maxPatients" id="maxPatients" min="1"
                                            placeholder="e.g., 20" required
                                            class="w-full border border-gray-300 rounded-md shadow-sm p-2.5 text-sm focus:ring-teal-500 focus:border-teal-500 bg-white">
                                    </div>

                                </div>

                                <div class="pt-2 flex justify-end">
                                    <button type="submit"
                                        class="w-full sm:w-auto bg-teal-600 hover:bg-teal-700 text-white font-bold py-2.5 px-6 rounded-md shadow-sm transition text-sm flex justify-center items-center gap-2">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                                        </svg>
                                        Save Shift
                                    </button>
                                </div>
                            </form>
                        </div>

                        <!-- 2. UPCOMING SHIFTS LIST (Overview) -->
                        <div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden">
                            <div
                                class="p-4 sm:p-6 border-b border-gray-100 flex justify-between items-center bg-gray-50/50">
                                <h2 class="text-lg font-semibold text-gray-800">Active Shifts</h2>
                            </div>

                            <!-- Responsive Table Container -->
                            <div class="overflow-x-auto">
                                <table class="w-full min-w-[600px] text-left border-collapse">
                                    <thead>
                                        <tr
                                            class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wider border-b border-gray-200">
                                            <th class="p-4 font-semibold">Date</th>
                                            <th class="p-4 font-semibold">Time Window</th>
                                            <th class="p-4 font-semibold text-center">Tokens Booked</th>
                                            <th class="p-4 font-semibold text-center">Status</th>
                                            <th class="p-4 font-semibold text-right">Action</th>
                                        </tr>
                                    </thead>

                                    <tbody class="text-sm text-gray-700 divide-y divide-gray-100">
                                        <!-- EJS Loop will go here. Example static row below: -->
                                        <% if (typeof schedules !=='undefined' && schedules.length> 0) { %>
                                            <% schedules.forEach(schedule=> { %>
                                                <tr class="hover:bg-teal-50/30 transition">
                                                    <td class="p-4 font-medium">
                                                        <%= schedule.date.toLocaleDateString('en-IN', { weekday: 'short'
                                                            , year: 'numeric' , month: 'short' , day: 'numeric' }) %>
                                                    </td>
                                                    <td class="p-4">
                                                        <%= schedule.startTime %> - <%= schedule.endTime %>
                                                    </td>
                                                    <td class="p-4 text-center">
                                                        <span class="font-bold text-gray-900">
                                                            <%= schedule.bookedCount %>
                                                        </span>
                                                        <span class="text-gray-400">/ <%= schedule.maxPatients %></span>
                                                    </td>
                                                    <td class="p-4 text-center">
                                                        <% if (schedule.bookedCount>= schedule.maxPatients) { %>
                                                            <span
                                                                class="bg-red-100 text-red-700 text-xs px-2 py-1 rounded-full font-medium">Full</span>
                                                            <% } else { %>
                                                                <span
                                                                    class="bg-green-100 text-green-700 text-xs px-2 py-1 rounded-full font-medium">Available</span>
                                                                <% } %>
                                                    </td>
                                                    <td class="p-4 text-right">
                                                        <!-- Update form for accidental creations -->
                                                        <form
                                                            action="/api/doctor/appointment/edit/schedule/<%= schedule._id %>"
                                                            method="GET">
                                                            <button type="submit"
                                                                class="text-green-500 hover:text-yellow-700 text-xs font-semibold uppercase tracking-wider">Update</button>
                                                        </form>
                                                    </td>
                                                    <td class="p-4 text-right">
                                                        <!-- Delete form for accidental creations -->
                                                        <form
                                                            action="/api/doctor/appointment/cancel/schedule/<%= schedule._id %>"
                                                            method="POST"
                                                            onsubmit="return confirm('Are you sure you want to delete this shift?');">
                                                            <button type="submit"
                                                                class="text-red-500 hover:text-red-700 text-xs font-semibold uppercase tracking-wider">Cancel</button>
                                                        </form>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                                    <% } else { %>
                                                        <tr>
                                                            <td colspan="5" class="p-8 text-center text-gray-500">
                                                                <svg class="w-12 h-12 mx-auto text-gray-300 mb-3"
                                                                    fill="none" stroke="currentColor"
                                                                    viewBox="0 0 24 24">
                                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                                        stroke-width="1.5"
                                                                        d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z">
                                                                    </path>
                                                                </svg>
                                                                You haven't scheduled any upcoming shifts yet.
                                                            </td>
                                                        </tr>
                                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                    </main>
        </div>

        <!-- Optional: Set minimum date to today using JS -->
        <script>
            const dateInput = document.getElementById('date');
            if (dateInput) {
                const today = new Date().toISOString().split('T')[0];
                dateInput.setAttribute('min', today);
            }
        </script>

        <%- include('partials/footer') %>