<%- include('partials/header') %>
  <%- include('partials/sidebar') %>

    <div class="md:ml-64 flex flex-col min-h-screen bg-gray-50">
      <%- include('partials/navbar') %>
        <%- include('partials/flash') %>

          <main class="flex-1 p-4 md:p-6 lg:p-8 w-full overflow-x-hidden">

            <!-- Header -->
            <div class="mb-8 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
              <div>
                <h1 class="text-2xl font-extrabold text-gray-900 tracking-tight">Earnings & Reports</h1>
                <p class="text-gray-500 text-sm mt-1 font-medium">Track your revenue and completed consultations.</p>
              </div>
              <button onclick="window.print()"
                class="inline-flex items-center gap-2 bg-white border border-gray-200 text-gray-700 font-bold px-4 py-2 rounded-full shadow-sm hover:bg-gray-50 hover:shadow transition-all">
                <i class="fa-solid fa-download"></i> Download Report
              </button>
            </div>

            <!-- Stats Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">

              <!-- Total Earnings Widget (Premium Card) -->
              <div
                class="bg-gradient-to-br from-teal-600 to-emerald-700 p-6 rounded-2xl shadow-lg shadow-teal-200 text-white relative overflow-hidden group">
                <div
                  class="absolute right-0 top-0 opacity-10 w-32 h-32 transform translate-x-8 -translate-y-8 group-hover:scale-110 transition-transform duration-500">
                  <i class="fa-solid fa-wallet text-9xl"></i>
                </div>
                <div class="relative z-10">
                  <p class="text-teal-100 font-bold uppercase tracking-wider text-xs mb-1">Total Earnings</p>
                  <h3 class="text-3xl font-extrabold mb-4">₹<%= typeof totalEarnings !=='undefined' ?
                      totalEarnings.toLocaleString('en-IN') : '0' %>
                  </h3>
                  <div
                    class="inline-flex items-center gap-1 text-xs font-bold bg-white/20 px-2.5 py-1 rounded-full border border-white/20 backdrop-blur-sm">
                    All-time revenue
                  </div>
                </div>
              </div>

              <!-- This Month -->
              <div
                class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex flex-col justify-between hover:shadow-md hover:border-blue-200 transition-all">
                <div>
                  <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-1">This Month</p>
                  <h3 class="text-2xl font-extrabold text-gray-900">₹<%= typeof monthlyEarnings !=='undefined' ?
                      monthlyEarnings.toLocaleString('en-IN') : '0' %>
                  </h3>
                </div>
                <div class="mt-4 flex items-center text-sm font-bold text-blue-600">
                  <i class="fa-solid fa-arrow-trend-up mr-1.5"></i> Trending well
                </div>
              </div>

              <!-- This Week -->
              <div
                class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex flex-col justify-between hover:shadow-md hover:border-indigo-200 transition-all">
                <div>
                  <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-1">This Week</p>
                  <h3 class="text-2xl font-extrabold text-gray-900">₹<%= typeof weeklyEarnings !=='undefined' ?
                      weeklyEarnings.toLocaleString('en-IN') : '0' %>
                  </h3>
                </div>
                <div class="mt-4 flex items-center text-sm font-bold text-indigo-500">
                  Current week revenue
                </div>
              </div>

              <!-- Total Consultations -->
              <div
                class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex flex-col justify-between hover:shadow-md hover:border-green-200 transition-all">
                <div>
                  <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-1">Completed Visits</p>
                  <h3 class="text-2xl font-extrabold text-gray-900">
                    <%= typeof transactions !=='undefined' ? transactions.length : '0' %>
                  </h3>
                </div>
                <div class="mt-4 flex items-center text-sm font-bold text-green-600">
                  <i class="fa-solid fa-check-circle mr-1.5"></i> Successful
                </div>
              </div>

            </div>

            <!-- Transactions List -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
              <div
                class="p-6 border-b border-gray-100 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-gray-50/50">
                <h2 class="text-lg font-extrabold text-gray-900">Recent Transactions</h2>
              </div>

              <div class="p-0">
                <% if (typeof transactions !=='undefined' && transactions.length> 0) { %>
                  <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                      <thead>
                        <tr
                          class="bg-white text-gray-400 text-xs font-bold uppercase tracking-wider border-b border-gray-100">
                          <th class="px-6 py-4">Date Completed</th>
                          <th class="px-6 py-4">Patient / Owner</th>
                          <th class="px-6 py-4 text-center">Payment Status</th>
                          <th class="px-6 py-4 text-right">Amount Earned</th>
                        </tr>
                      </thead>
                      <tbody class="divide-y divide-gray-50">
                        <% transactions.forEach(txn=> { %>
                          <tr class="hover:bg-gray-50/50 transition-colors group">
                            <td class="px-6 py-4">
                              <p class="font-bold text-gray-900">
                                <%= new Date(txn.updatedAt || txn.appointmentDate).toLocaleDateString('en-US', {
                                  month: 'short' , day: 'numeric' , year: 'numeric' }) %>
                              </p>
                              <p class="text-xs font-medium text-gray-500 mt-0.5"><i
                                  class="fa-regular fa-clock mr-1"></i>
                                <%= new Date(txn.updatedAt || txn.appointmentDate).toLocaleTimeString('en-US', {
                                  hour: '2-digit' , minute:'2-digit' }) %>
                              </p>
                            </td>
                            <td class="px-6 py-4">
                              <div class="flex items-center gap-3">
                                <div
                                  class="w-9 h-9 rounded-full bg-teal-50 border border-teal-100 text-teal-600 flex items-center justify-center font-bold shadow-sm overflow-hidden">

                                  <% if (txn.pet && txn.pet.image) { %>
                                    <!-- If pet has an image, display it -->
                                    <img src="<%= txn.pet.image %>" alt="<%= txn.pet.name %>"
                                      class="w-full h-full object-cover" />
                                    <% } else { %>
                                      <!-- Fallback icon if no image exists -->
                                      <i class="fa-solid fa-paw text-sm"></i>
                                      <% } %>
                                </div>
                                <div>
                                  <p class="font-extrabold text-gray-900">
                                    <%= txn.pet ? txn.pet.name : 'Unknown Pet' %>
                                  </p>
                                  <p class="text-xs font-medium text-gray-500">Owner: <%= txn.owner ? txn.owner.name
                                      : 'Unknown' %>
                                  </p>
                                </div>
                              </div>
                            </td>
                            <td class="px-6 py-4 text-center">
                              <span
                                class="inline-flex items-center px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wide bg-green-50 text-green-700 border border-green-200 shadow-sm">
                                Paid
                              </span>
                            </td>
                            <td class="px-6 py-4 text-right">
                              <p class="font-extrabold text-lg text-gray-900">₹<%= txn.consultationFee ?
                                  txn.consultationFee.toLocaleString('en-IN') : '0' %>
                              </p>
                            </td>
                          </tr>
                          <% }) %>
                      </tbody>
                    </table>
                  </div>
                  <% } else { %>
                    <div class="py-16 px-6 text-center">
                      <div
                        class="w-20 h-20 bg-gray-50 rounded-full flex items-center justify-center mx-auto mb-5 border border-gray-100 shadow-inner">
                        <i class="fa-solid fa-receipt text-3xl text-gray-400"></i>
                      </div>
                      <h3 class="text-lg font-extrabold text-gray-900 mb-1">No transactions yet</h3>
                      <p class="text-gray-500 text-sm max-w-sm mx-auto font-medium leading-relaxed">Completed
                        appointments and their earnings will appear here.</p>
                    </div>
                    <% } %>
              </div>
            </div>
          </main>
    </div>

    <%- include('partials/footer') %>