<header class="bg-white shadow-sm sticky top-0 z-50 w-full border-b border-gray-200">
  <div class="flex items-center justify-between px-4 py-3 md:px-6">
    
    <!-- Left Side: Mobile Menu & Brand -->
    <div class="flex items-center gap-3">
      <!-- Mobile Hamburger Button (Hidden on Desktop) -->
      <button id="mobile-menu-btn" class="md:hidden text-gray-600 hover:text-teal-600 focus:outline-none p-1 rounded-md active:bg-gray-100">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
      
      <!-- Brand Name (Visible on mobile, hidden on desktop because the sidebar has it) -->
      <a href="/doctor/dashboard" class="text-xl font-bold text-teal-600 md:hidden">Poshik</a>
    </div>

    <!-- Right Side: Notifications & Profile -->
    <div class="flex items-center gap-4">
      
      <!-- Notification Bell -->
      <button class="text-gray-500 hover:text-teal-600 relative p-1 focus:outline-none rounded-full hover:bg-gray-50 transition">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
        </svg>
        <!-- Red Notification Dot -->
        <span class="absolute top-1 right-1 block h-2.5 w-2.5 rounded-full bg-red-500 ring-2 ring-white"></span>
      </button>

      <!-- User Profile & Dropdown -->
      <div class="relative group">
        <button class="flex items-center gap-2 focus:outline-none p-1 rounded-lg hover:bg-gray-50 transition">
          <img src="<%= typeof user !== 'undefined' && user && user.image ? user.image : '/images/default-avatar.png' %>" alt="Profile" class="w-8 h-8 md:w-9 md:h-9 rounded-full object-cover border-2 border-teal-500">
          <span class="hidden md:block text-sm font-medium text-gray-700">Dr. <%= user.name.split(' ')[0] %></span>
          <svg class="w-4 h-4 text-gray-500 hidden md:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>
        
        <!-- Dropdown Menu (Appears on hover) -->
        <div class="absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg py-1 ring-1 ring-black ring-opacity-5 hidden group-hover:block transition-all z-50">
          <!-- <a href="/doctor/profile" class="block px-4 py-2 text-sm text-gray-700 hover:bg-teal-50 hover:text-teal-600 transition">My Profile</a> -->
          
          <!-- Add lock icon if KYC is not approved -->
          <!-- <a href="<%= user.kycStatus === 'Approved' ? '/doctor/settings' : '#' %>" class="block px-4 py-2 text-sm text-gray-700 hover:bg-teal-50 hover:text-teal-600 transition <%= user.kycStatus !== 'Approved' ? 'opacity-50 cursor-not-allowed' : '' %>">
            Settings <%= user.kycStatus !== 'Approved' ? '🔒' : '' %>
          </a> -->
          
          <div class="border-t border-gray-100 mt-1 mb-1"></div>
          <a href="/auth/logout" class="block px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition">Logout</a>
        </div>
      </div>

    </div>
  </div>
</header>