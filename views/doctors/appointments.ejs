<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<div class="md:ml-64 flex flex-col min-h-screen bg-gray-50">
  <%- include('partials/navbar') %>
  <%- include('partials/flash') %>
  
  <main class="flex-1 p-4 md:p-6 lg:p-8 w-full overflow-x-hidden">
    <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <h1 class="text-2xl font-bold text-gray-800">My Appointments</h1>
    </div>

    <div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden">
      <% if (appointments && appointments.length > 0) { %>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Patient Details</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Schedule</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Reason / Token</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Action</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% appointments.forEach(appt => { %>
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="flex items-center">
                      <div>
                        <div class="text-sm font-bold text-gray-900"><%= appt.pet.name %> (<%= appt.pet.species %>)</div>
                        <div class="text-xs text-gray-500 mt-1">Owner: <%= appt.owner.name %></div>
                        
                      </div>
                    </div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm font-medium text-gray-900"><%= new Date(appt.schedule.date).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' }) %></div>
                    <div class="text-xs text-gray-500 mt-1"><i class="fa-regular fa-clock"></i> <%= appt.schedule.startTime %> - <%= appt.schedule.endTime %></div>
                  </td>
                  <td class="px-6 py-4">
                    <div class="text-sm text-gray-900 max-w-[200px] truncate" title="<%= appt.reason %>"><%= appt.reason %></div>
                    <div class="text-xs font-bold text-teal-600 mt-1">Token: #<%= appt.tokenNumber %></div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <% 
                      let statusClass = "bg-gray-100 text-gray-800";
                      if (appt.status === 'Confirmed') statusClass = "bg-blue-100 text-blue-800";
                      if (appt.status === 'Completed') statusClass = "bg-green-100 text-green-800";
                      if (appt.status === 'Cancelled' || appt.status === 'Rejected') statusClass = "bg-red-100 text-red-800";
                      if (appt.status === 'Pending') statusClass = "bg-yellow-100 text-yellow-800";
                    %>
                    <span class="px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full <%= statusClass %>">
                      <%= appt.status %>
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                    <form action="/api/doctor/appointments/update/<%= appt._id %>" method="POST" class="inline-flex flex-col sm:flex-row items-center gap-2">
                      <select name="status" class="text-sm border-gray-300 rounded-md shadow-sm focus:border-teal-500 focus:ring focus:ring-teal-200 focus:ring-opacity-50 py-1.5 pl-3 pr-8">
                        <option value="Confirmed" <%= appt.status === 'Confirmed' ? 'selected' : '' %>>Confirm</option>
                        <option value="Completed" <%= appt.status === 'Completed' ? 'selected' : '' %>>Complete</option>
                        <option value="Rejected" <%= appt.status === 'Rejected' ? 'selected' : '' %>>Reject</option>
                        <option value="Cancelled" <%= appt.status === 'Cancelled' ? 'selected' : '' %>>Cancel</option>
                      </select>
                      <button type="submit" class="bg-teal-600 hover:bg-teal-700 text-white px-3 py-1.5 rounded-md text-xs font-medium shadow-sm transition">Update</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <!-- Empty State -->
        <div class="text-center py-12 md:py-16">
          <svg class="w-16 h-16 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
          <h3 class="text-lg font-medium text-gray-900">No appointments found</h3>
          <p class="mt-1 text-sm text-gray-500">When patients book appointments, they will appear here.</p>
        </div>
      <% } %>
    </div>
  </main>
</div>

<%- include('partials/footer') %>