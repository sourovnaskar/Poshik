<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%=Title%></title>
  <!-- Using Tailwind CSS for styling -->
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    /* Custom style for the background image side */
    .bg-login-image {
      background-image: url('https://images.unsplash.com/photo-1450778869180-41d0601e046e?w=600&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8Mnx8cGV0cyUyMGltYWdlfGVufDB8fDB8fHww'); /* REPLACE WITH YOUR IMAGE URL */
      background-size: cover;
      background-position: center;
    }
  </style>
</head>
<body class="bg-gray-50 min-h-screen flex items-center justify-center">

  <div class="flex flex-col md:flex-row w-full max-w-7xl mx-auto md:mx-4 bg-white rounded-xl shadow-2xl overflow-hidden min-h-[70vh]">
    
    <!-- Left Side: Image & Welcome (Hidden on Mobile) -->
    <div class="hidden md:flex md:w-1/2 bg-login-image relative p-12 flex-col justify-between text-white">
      <div class="absolute inset-0 bg-black opacity-30"></div> <!-- Overlay for text readability -->
      <div class="relative z-10">
        <h1 class="text-5xl font-extrabold tracking-tight">Poshik</h1>
        <p class="mt-4 text-xl text-gray-100">Welcome back to your pet's favorite corner.</p>
      </div>
      <div class="relative z-10">
        <p class="text-sm text-gray-200">Everything you need for your companions, just a login away.</p>
      </div>
    </div>

    <!-- Right Side: Login Form -->
    <div class="w-full md:w-1/2 p-8 md:p-12 xl:p-16 flex flex-col justify-center">
      
      <div class="max-w-md mx-auto w-full">
        <div class="md:hidden text-center mb-8">
            <h1 class="text-4xl font-extrabold text-blue-600 tracking-tight">Poshik</h1>
        </div>
        <h2 class="text-3xl font-bold text-gray-900 mb-2">Welcome Back</h2>
        <p class="text-gray-600 mb-8">Please enter your credentials to access your account.</p>

        <!-- Flash Success Message -->
        <% if (typeof successMsg !== 'undefined' && successMsg.length > 0) { %>
          <div class="bg-green-50 border-l-4 border-green-500 text-green-800 p-4 mb-6 rounded shadow-sm" role="alert">
            <p class="font-medium">Success</p>
            <p class="text-sm"><%= successMsg %></p>
          </div>
        <% } %>

        <!-- Flash Error Message Block -->
        <% if (typeof errorMsg !== 'undefined' && errorMsg.length > 0) { %>
          <div class="bg-red-50 border-l-4 border-red-500 text-red-800 p-4 mb-6 rounded shadow-sm" role="alert">
            <p class="font-medium">Error</p>
            <p class="text-sm"><%= errorMsg %></p>
          </div>
        <% } %>

        <form action="/api/auth/login-create" method="POST" class="space-y-6">
          
          <!-- Email -->
          <div>
            <label for="email" class="block text-sm font-semibold text-gray-700">Email Address</label>
            <input type="email" id="email" name="email" required placeholder="your.email@example.com"
              class="mt-1 block w-full px-4 py-3 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-200 focus:border-blue-400 transition">
          </div>

          <!-- Password -->
          <div>
            <div class="flex items-center justify-between">
                <label for="password" class="block text-sm font-semibold text-gray-700">Password</label>
                <!-- Placeholder for future forgot password feature -->
                <!-- <a href="#" class="text-xs font-medium text-blue-600 hover:text-blue-500">Forgot password?</a> -->
            </div>
            <input type="password" id="password" name="password" required placeholder="••••••••"
              class="mt-1 block w-full px-4 py-3 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-200 focus:border-blue-400 transition">
          </div>

          <!-- Submit Button -->
          <button type="submit" 
            class="w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-md text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition duration-150 ease-in-out mt-10">
            Log In
          </button>

        </form>

        <p class="mt-10 text-center text-sm text-gray-600">
          Don't have an account? <a href="/api/auth/register" class="font-semibold text-blue-600 hover:text-blue-500 transition">Register here</a>
        </p>
      </div>

    </div>
  </div>

</body>
</html>