# ==========================================
# POSHIK - ENVIRONMENT VARIABLES TEMPLATE
# ==========================================
# INSTRUCTIONS: Copy this file, rename it to '.env', 
# and replace the placeholder values with your actual credentials.

# Server Configuration
PORT=3000
BASE_URL=http://localhost:3000

# Database
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/poshik

# JWT Authentication Secrets
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_REFRESH_SECRET_KEY=your_jwt_refresh_secret_key_here

# Cloudinary Integration (Images)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Service (Nodemailer / Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=your_email@gmail.com

# Express Session
SESSION_SECRET=your_session_secret_here